---
// BaseLayout.astro — Root layout matching TopNepali / GeneratePress visual architecture
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
}

const {
  title = 'Top Nepali — News, Updates, Educational Information',
  description = 'Covering top Nepali news, verified exam routines, educational notices, and digital utility services built specifically for Nepal.',
  image = 'https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png',
  type = 'website',
  canonicalUrl,
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://topnepali.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Top Nepali" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Favicon -->
    <link rel="icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-32x32.png" sizes="32x32" />
    <link rel="icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-180x180.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://objects.topnepali.com" crossorigin />

    <style is:global>
      @import "tailwindcss";

      :root {
        --color-brand: #21138a;
        --color-brand-hover: #3b49e4;
        --color-bg-base: #f0f0f0;
        --color-card-bg: #ffffff;
        --color-text-main: #222222;
        --color-text-muted: #575760;
        --color-border: #e2e8f0;
      }

      .dark {
        --color-brand: #60a5fa;
        --color-brand-hover: #93c5fd;
        --color-bg-base: #0b0f19;
        --color-card-bg: #0f172a;
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --color-border: #1e293b;
      }

      body {
        background-color: var(--color-bg-base);
        color: var(--color-text-main);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
      }

      /* Prose & Rendered WordPress Content Styling */
      .entry-content {
        color: #334155;
        font-size: 16px;
        line-height: 1.8;
      }

      .dark .entry-content {
        color: #cbd5e1;
      }

      .entry-content p {
        margin-bottom: 1.5em;
        text-align: justify;
      }

      .entry-content h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin-top: 2rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
      }

      .dark .entry-content h2 {
        color: #f8fafc;
        border-bottom-color: #1e293b;
      }

      .entry-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
        line-height: 1.35;
      }

      .dark .entry-content h3 {
        color: #f1f5f9;
      }

      .entry-content ul,
      .entry-content ol {
        margin-bottom: 1.5em;
        padding-left: 1.5em;
      }

      .entry-content ul {
        list-style-type: disc;
      }

      .entry-content ol {
        list-style-type: decimal;
      }

      .entry-content li {
        margin-bottom: 0.5em;
      }

      .entry-content a {
        color: #21138a;
        text-decoration: underline;
        font-weight: 500;
      }

      .dark .entry-content a {
        color: #60a5fa;
      }

      .entry-content blockquote {
        border-left: 4px solid #21138a;
        padding: 0.75rem 1.25rem;
        margin: 1.5rem 0;
        background: #f8fafc;
        border-radius: 0 8px 8px 0;
        font-style: italic;
        color: #475569;
      }

      .dark .entry-content blockquote {
        border-left-color: #60a5fa;
        background: #1e293b;
        color: #cbd5e1;
      }

      .entry-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 14px;
        overflow-x: auto;
        display: block;
      }

      .entry-content th,
      .entry-content td {
        border: 1px solid #e2e8f0;
        padding: 8px 12px;
        text-align: left;
      }

      .dark .entry-content th,
      .dark .entry-content td {
        border-color: #334155;
      }

      .entry-content th {
        background-color: #f1f5f9;
        font-weight: 700;
        color: #0f172a;
      }

      .dark .entry-content th {
        background-color: #1e293b;
        color: #f8fafc;
      }

      .entry-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1.5rem auto;
      }

      .entry-content figure {
        margin: 1.5rem 0;
      }

      .entry-content figcaption {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        margin-top: 6px;
      }
    </style>
  </head>

  <body>
    <Header currentPath={Astro.url.pathname} />

    <main class="site-main flex-1">
      <slot />
    </main>

    <Footer />
    <SearchModal />
  </body>
</html>
