---
// BaseLayout.astro — Root layout matching TopNepali / GeneratePress visual architecture
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
}

const {
  title = 'Top Nepali — News, Updates, Educational Information',
  description = 'Covering top Nepali news, verified exam routines, educational notices, and digital utility services built specifically for Nepal.',
  image = 'https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png',
  type = 'website',
  canonicalUrl,
} = Astro.props;

import { SITE_URL, GTM_ID, GA_ID, ADSENSE_ID } from '../config';

const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).toString();
const gaId = GA_ID;
const adsenseId = ADSENSE_ID;
const gtmId = GTM_ID;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Top Nepali RSS Feed" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Top Nepali" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Favicon -->
    <link rel="icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-32x32.png" sizes="32x32" />
    <link rel="icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-180x180.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://objects.topnepali.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />

    <!-- Color Scheme & Light Theme -->
    <meta name="color-scheme" content="light" />

    <!-- Google Analytics (GA4) -->
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Google AdSense -->
    {adsenseId && (
      <script
        is:inline
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
      ></script>
    )}

    <!-- Google Tag Manager (Optional) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === 'article' ? 'NewsArticle' : 'WebSite',
      "name": title,
      "headline": title,
      "description": description,
      "url": canonical,
      ...(image ? { "image": [image] } : {}),
      "publisher": {
        "@type": "Organization",
        "name": "Top Nepali",
        "url": "https://topnepali.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png"
        }
      }
    })} />

    <style is:global>
      @import "tailwindcss";

      :root {
        color-scheme: light;
        --color-brand: #21138a;
        --color-brand-hover: #3b49e4;
        --color-bg-base: #f5f6f8;
        --color-card-bg: #ffffff;
        --color-text-main: #1e293b;
        --color-text-muted: #64748b;
        --color-border: #e2e8f0;
      }

      html {
        color-scheme: light;
        background-color: #f5f6f8;
      }

      body {
        background-color: #f5f6f8;
        color: #1e293b;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
      }

      /* Prose & Rendered WordPress Content Styling */
      .entry-content {
        color: #1e293b;
        font-size: 16px;
        line-height: 1.8;
      }

      .entry-content p {
        margin-bottom: 1.5em;
        text-align: justify;
      }

      .entry-content h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin-top: 2rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
      }

      .entry-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
        line-height: 1.35;
      }

      .entry-content ul,
      .entry-content ol {
        margin-bottom: 1.5em;
        padding-left: 1.5em;
      }

      .entry-content ul {
        list-style-type: disc;
      }

      .entry-content ol {
        list-style-type: decimal;
      }

      .entry-content li {
        margin-bottom: 0.5em;
      }

      .entry-content a {
        color: #21138a;
        text-decoration: underline;
        font-weight: 500;
      }

      .entry-content blockquote {
        border-left: 4px solid #21138a;
        padding: 0.75rem 1.25rem;
        margin: 1.5rem 0;
        background: #f8fafc;
        border-radius: 0 8px 8px 0;
        font-style: italic;
        color: #475569;
      }

      .entry-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 14px;
        overflow-x: auto;
        display: block;
      }

      .entry-content th,
      .entry-content td {
        border: 1px solid #e2e8f0;
        padding: 8px 12px;
        text-align: left;
      }

      .entry-content th {
        background-color: #f1f5f9;
        font-weight: 700;
        color: #0f172a;
      }

      .entry-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1.5rem auto;
      }

      .entry-content figure {
        margin: 1.5rem 0;
      }

      .entry-content figcaption {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        margin-top: 6px;
      }
    </style>
  </head>

  <body>
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <Header currentPath={Astro.url.pathname} />

    <main class="site-main flex-1">
      <slot />
    </main>

    <Footer />
    <SearchModal />
  </body>
</html>
