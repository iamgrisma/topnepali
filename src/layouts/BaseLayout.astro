---
// BaseLayout.astro | Root layout matching TopNepali / GeneratePress visual architecture
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonicalUrl?: string;
  canonical?: string;
  headHtml?: string | null;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  section?: string;
  robots?: string | null;
  preloadImage?: string;
}

const {
  title = 'Top Nepali | News, Updates, Educational Information',
  description = 'Covering top Nepali news, verified exam routines, educational notices, and digital utility services built specifically for Nepal.',
  image = 'https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png',
  type = 'website',
  canonicalUrl,
  canonical: canonicalProp,
  headHtml = null,
  publishedTime,
  modifiedTime,
  authorName,
  section,
  robots,
  preloadImage,
} = Astro.props;

import { SITE_URL, GA_ID, ADSENSE_ID, CLARITY_ID } from '../config';

const canonical = canonicalUrl || canonicalProp || new URL(Astro.url.pathname, SITE_URL).toString();
const gaId = GA_ID;
const adsenseId = ADSENSE_ID;
const clarityId = CLARITY_ID;
const cleanTitle = (title || '').replace(/[\u2014\u2013]/g, '|');
const cleanDescription = (description || '').replace(/[\u2014\u2013]/g, '-');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Verification & Monetization Meta */}
    <meta name="monetag" content="5c257f1f9f4a320696d71ee77d24020c" />
    <meta name="google-adsense-account" content="ca-pub-5410507143596599" />
    <meta name="twitter:site" content="@topnepalicom" />

    {headHtml ? (
      /* Directly render Rank Math's exact head HTML from WordPress (sanitizing em dashes to vertical pipes) */
      <Fragment set:html={headHtml.replace(/[\u2014\u2013]/g, '|')} />
    ) : (
      /* Fallback native SEO tags & Google JSON-LD schema */
      <>
        <title>{cleanTitle}</title>
        <meta name="description" content={cleanDescription} />
        <link rel="canonical" href={canonical} />
        {robots && <meta name="robots" content={robots} />}

        <!-- Open Graph -->
        <meta property="og:site_name" content="Top Nepali" />
        <meta property="og:title" content={cleanTitle} />
        <meta property="og:description" content={cleanDescription} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonical} />
        {image && <meta property="og:image" content={image} />}
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {section && <meta property="article:section" content={section} />}

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {image && <meta name="twitter:image" content={image} />}

        <!-- Schema.org JSON-LD Structured Data -->
        {type === 'article' ? (
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
              "@context": "https://schema.org",
              "@type": "NewsArticle",
              "headline": title,
              "description": description,
              "image": image ? [image] : [],
              "datePublished": publishedTime || new Date().toISOString(),
              "dateModified": modifiedTime || publishedTime || new Date().toISOString(),
              "author": [{
                "@type": "Person",
                "name": authorName || "Top Nepali Editorial Team",
                "url": "https://topnepali.com"
              }],
              "publisher": {
                "@type": "Organization",
                "name": "Top Nepali",
                "url": "https://topnepali.com",
                "logo": {
                  "@type": "ImageObject",
                  "url": "https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png"
                }
              },
              "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": canonical
              },
              ...(section ? { "articleSection": section } : {})
            })}
          />
        ) : (
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
              "@context": "https://schema.org",
              "@type": "WebSite",
              "name": "Top Nepali",
              "url": "https://topnepali.com",
              "potentialAction": {
                "@type": "SearchAction",
                "target": "https://topnepali.com/search?q={search_term_string}",
                "query-input": "required name=search_term_string"
              }
            })}
          />
        )}
      </>
    )}

    <link rel="alternate" type="application/rss+xml" title="Top Nepali RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Top Nepali Feed" href="/feed" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Favicon -->
    <link rel="icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-32x32.png" sizes="32x32" />
    <link rel="icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://objects.topnepali.com/wp-content/uploads/2026/09/cropped-Top-Nepali-Logo-180x180.png" />

    <!-- Preload Critical LCP Image -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- Preconnect & DNS-Prefetch -->
    <link rel="dns-prefetch" href="https://objects.topnepali.com" />
    <link rel="preconnect" href="https://objects.topnepali.com" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="preconnect" href="https://www.clarity.ms" crossorigin />

    <!-- Color Scheme & Light Theme -->
    <meta name="color-scheme" content="light" />

    <!-- Google AdSense -->
    {adsenseId && (
      <script
        is:inline
        defer
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`}
      ></script>
    )}

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K2R0GSQE0M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-K2R0GSQE0M');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "7n9ehw4x5h");
    </script>

    <style is:global>
      @import "tailwindcss";

      :root {
        color-scheme: light;
        --color-brand: #21138a;
        --color-brand-hover: #3b49e4;
        --color-bg-base: #f5f6f8;
        --color-card-bg: #ffffff;
        --color-text-main: #1e293b;
        --color-text-muted: #64748b;
        --color-border: #e2e8f0;
      }

      html {
        color-scheme: light;
        background-color: #f5f6f8;
      }

      body {
        background-color: #f5f6f8;
        color: #1e293b;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
      }

      /* Prose & Rendered WordPress Content Styling */
      .entry-content {
        color: #1e293b;
        font-size: 16px;
        line-height: 1.8;
      }

      .entry-content p {
        margin-bottom: 1.5em;
        text-align: justify;
      }

      .entry-content h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
        margin-top: 2rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
      }

      .entry-content h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
        line-height: 1.35;
      }

      .entry-content ul,
      .entry-content ol {
        margin-bottom: 1.5em;
        padding-left: 1.5em;
      }

      .entry-content ul {
        list-style-type: disc;
      }

      .entry-content ol {
        list-style-type: decimal;
      }

      .entry-content li {
        margin-bottom: 0.5em;
      }

      .entry-content a {
        color: #21138a;
        text-decoration: underline;
        font-weight: 500;
      }

      .entry-content blockquote {
        border-left: 4px solid #21138a;
        padding: 0.75rem 1.25rem;
        margin: 1.5rem 0;
        background: #f8fafc;
        border-radius: 0 8px 8px 0;
        font-style: italic;
        color: #475569;
      }

      .entry-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 14px;
        overflow-x: auto;
        display: block;
      }

      .entry-content th,
      .entry-content td {
        border: 1px solid #e2e8f0;
        padding: 8px 12px;
        text-align: left;
      }

      .entry-content th {
        background-color: #f1f5f9;
        font-weight: 700;
        color: #0f172a;
      }

      .entry-content img {
        max-width: 100%;
        height: auto;
        object-fit: contain;
        border-radius: 8px;
        margin: 1.5rem auto;
        display: block;
      }

      .entry-content figure {
        margin: 1.5rem 0;
      }

      .entry-content figcaption {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        margin-top: 6px;
      }

      /* Responsive Video & Iframe Embeds */
      .entry-content .wp-block-embed,
      .entry-content figure.is-type-video {
        margin: 1.5rem 0;
        width: 100%;
        max-width: 100%;
      }

      .entry-content .wp-block-embed__wrapper,
      .entry-content .aspect-video {
        position: relative;
        width: 100%;
        max-width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 0.5rem;
        overflow: hidden;
        background-color: #0f172a;
        border: 1px solid #e2e8f0;
      }

      .entry-content .wp-block-embed iframe,
      .entry-content .wp-block-embed__wrapper iframe,
      .entry-content .aspect-video iframe,
      .entry-content figure iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        max-height: 100% !important;
        border: 0;
        display: block;
      }

      /* Heading scroll margin to prevent sticky header overlap */
      .entry-content h2,
      .entry-content h3,
      .entry-content h4 {
        scroll-margin-top: 5rem;
      }

      /* Universal Table of Contents Styling (Rank Math, UAGB, Easy TOC) */
      .entry-content .wp-block-uagb-table-of-contents,
      .entry-content .wp-block-rank-math-toc-block,
      .entry-content #ez-toc-container,
      .entry-content .table-of-contents,
      .entry-content .toc-container {
        background-color: #f8fafc !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 1rem !important;
        padding: 1.25rem 1.5rem !important;
        margin: 1.75rem 0 !important;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03) !important;
      }

      .entry-content .wp-block-uagb-table-of-contents .uagb-toc__title,
      .entry-content .wp-block-rank-math-toc-block h2,
      .entry-content #ez-toc-container .ez-toc-title {
        font-size: 1.05rem !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin-top: 0 !important;
        margin-bottom: 0.75rem !important;
        padding-bottom: 0.5rem !important;
        border-bottom: 1px solid #e2e8f0 !important;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .entry-content .wp-block-uagb-table-of-contents ol,
      .entry-content .wp-block-rank-math-toc-block ul,
      .entry-content #ez-toc-container ul {
        margin: 0 !important;
        padding-left: 1.25rem !important;
        list-style-type: decimal !important;
      }

      .entry-content .wp-block-uagb-table-of-contents li,
      .entry-content .wp-block-rank-math-toc-block li,
      .entry-content #ez-toc-container li {
        margin-bottom: 0.4rem !important;
        font-size: 0.875rem !important;
        line-height: 1.5 !important;
        color: #334155 !important;
      }

      .entry-content .wp-block-uagb-table-of-contents a,
      .entry-content .wp-block-rank-math-toc-block a,
      .entry-content #ez-toc-container a {
        color: #3730a3 !important;
        text-decoration: none !important;
        font-weight: 500 !important;
        transition: color 0.15s ease;
      }

      .entry-content .wp-block-uagb-table-of-contents a:hover,
      .entry-content .wp-block-rank-math-toc-block a:hover,
      .entry-content #ez-toc-container a:hover {
        color: #1e1b4b !important;
        text-decoration: underline !important;
      }
    </style>
  </head>

  <body>
    <Header currentPath={Astro.url.pathname} />

    <main class="site-main flex-1">
      <slot />
    </main>

    <Footer />
    <SearchModal />
    <BackToTop />
  </body>
</html>
