---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="404: Page Not Found | Top Nepali"
  description="The page you were looking for could not be found."
  robots="noindex, nofollow"
>
  <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
    <Breadcrumb
      items={[
        { label: 'Portal Home', href: '/' },
        { label: '404 Not Found' }
      ]}
    />

    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <div class="w-full lg:w-[68%] min-w-0">
        <EmptyState
          title="404: Page Not Found"
          message="The page you requested could not be found. It may have been moved, renamed, or is temporarily unavailable."
          icon="file-question"
          primaryAction={{ label: 'Return to Portal', href: '/' }}
          secondaryAction={{ label: 'Browse All Blogs', href: '/blogs' }}
        />
      </div>
      <div class="w-full lg:w-[32%] shrink-0">
        <Sidebar />
      </div>
    </div>
  </div>
</BaseLayout>
