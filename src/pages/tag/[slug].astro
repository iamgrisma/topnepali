---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveStream from '../../components/ArchiveStream.astro';
import EmptyState from '../../components/EmptyState.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getTagBySlug, getPosts } from '../../lib/wp';

const rawSlug = Astro.params.slug || '';
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

const tag = cleanSlug ? await getTagBySlug(cleanSlug) : null;
if (!tag) {
  Astro.response.status = 404;
}

const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

let posts: any[] = [];
let total = 0;
let totalPages = 0;

if (tag) {
  const postsResult = await getPosts({
    tag: tag.id,
    page: currentPage,
    perPage,
  });
  posts = postsResult.data;
  total = postsResult.total;
  totalPages = postsResult.totalPages;
}

const breadcrumbs = [
  { label: 'Portal Home', href: '/' },
  { label: 'Blogs', href: '/blogs' },
  { label: 'Tag' },
  { label: tag ? `#${tag.name}` : 'Not Found' },
];
---

<BaseLayout
  title={tag ? `Tag: #${tag.name} | Top Nepali` : 'Tag Not Found | Top Nepali'}
  description={tag?.description || `Articles and updates tagged under #${tag?.name || cleanSlug} on Top Nepali.`}
  canonicalUrl={currentPage > 1 ? `https://topnepali.com/tag/${cleanSlug}?page=${currentPage}` : `https://topnepali.com/tag/${cleanSlug}`}
  robots={!tag ? 'noindex, nofollow' : undefined}
>
  {!tag ? (
    <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-10">
      <Breadcrumb
        items={[
          { label: 'Portal Home', href: '/' },
          { label: 'Blogs', href: '/blogs' },
          { label: 'Tag Not Found' }
        ]}
      />
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <div class="w-full lg:w-[68%] min-w-0">
          <EmptyState
            title="Tag Not Located"
            message={`No articles are currently indexed under the tag "#${cleanSlug}".`}
            icon="tag"
            primaryAction={{ label: 'Browse All Blogs', href: '/blogs' }}
            secondaryAction={{ label: 'Return to Portal', href: '/' }}
          />
        </div>
        <div class="w-full lg:w-[32%] shrink-0">
          <Sidebar />
        </div>
      </div>
    </div>
  ) : (
    <ArchiveStream
      badgeLabel="Topic Tag"
      heading={`#${tag.name}`}
      description={tag.description || `Articles and editorial publications tagged with #${tag.name}.`}
      total={total}
      breadcrumbs={breadcrumbs}
      posts={posts}
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl={`/tag/${cleanSlug}`}
      emptyMessage="No articles found under this tag yet."
    />
  )}
</BaseLayout>
