---
// search.astro — Dynamic SSR Search Results page for TopNepali
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Pagination from '../components/Pagination.astro';
import { getPosts } from '../lib/wp';

const query = Astro.url.searchParams.get('q') || Astro.url.searchParams.get('s') || '';
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

let postsResult = { data: [], total: 0, totalPages: 0, currentPage: 1 };
if (query.trim()) {
  postsResult = await getPosts({
    search: query.trim(),
    page: currentPage,
    perPage,
  });
}

const { data: posts, total, totalPages } = postsResult;
---

<BaseLayout
  title={query ? `Search: "${query}" — Top Nepali` : 'Search Articles — Top Nepali'}
  description={`Search results for ${query} on Top Nepali digital archive.`}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-slate-200 font-semibold">Search</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- Primary Content Area -->
      <div class="w-full lg:w-[68%] min-w-0">
        
        <!-- Search Header & Inline Input Box -->
        <div class="p-6 mb-8 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-2xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Search Results</span>
            {query && (
              <>
                <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                <span class="text-xs text-slate-500 font-mono">{total} Matches Found</span>
              </>
            )}
          </div>
          
          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mb-4">
            {query ? `Results for "${query}"` : 'Search Articles'}
          </h1>

          <form action="/search" method="get" class="flex gap-2">
            <div class="relative flex-1">
              <input
                type="search"
                name="q"
                value={query}
                placeholder="Type your search query..."
                required
                class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg pl-3 pr-4 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-indigo-600 dark:focus:border-indigo-400 transition"
              />
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 bg-indigo-900 dark:bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-800 dark:hover:bg-indigo-500 transition cursor-pointer shrink-0"
            >
              Search
            </button>
          </form>
        </div>

        <!-- Results Grid -->
        {query ? (
          posts.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <div class="p-10 text-center bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800">
              <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              </div>
              <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">
                No matching articles found
              </h2>
              <p class="text-slate-500 text-xs max-w-sm mx-auto mb-4">
                We couldn't find any articles matching your search query. Please try searching with different keywords.
              </p>
              <a href="/" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
                Return to Homepage
              </a>
            </div>
          )
        ) : (
          <div class="p-10 text-center bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800">
            <p class="text-slate-500 text-xs">
              Enter a search query in the box above to find articles.
            </p>
          </div>
        )}

        <!-- Dynamic Pagination -->
        {query && (
          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl="/search"
            searchParams={{ q: query }}
          />
        )}
      </div>

      <!-- Right Sidebar -->
      <div class="w-full lg:w-[32%] shrink-0">
        <Sidebar />
      </div>

    </div>
  </div>
</BaseLayout>
