---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Pagination from '../components/Pagination.astro';
import EmptyState from '../components/EmptyState.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { searchPosts } from '../lib/wp';

const query = Astro.url.searchParams.get('q') || Astro.url.searchParams.get('s') || '';
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

let postsResult = { data: [], total: 0, totalPages: 0, currentPage: 1 };
if (query.trim()) {
  postsResult = await searchPosts(query.trim(), currentPage, perPage);
}

const { data: posts, total, totalPages } = postsResult;
---

<BaseLayout
  title={query ? `Search: ${query} | Top Nepali` : 'Search Articles | Top Nepali'}
  description={`Search results for ${query} on Top Nepali digital archive.`}
  canonicalUrl="https://topnepali.com/search"
  robots="noindex, follow"
>
  <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
    <Breadcrumb
      items={[
        { label: 'Portal Home', href: '/' },
        { label: query ? `Search: "${query}"` : 'Search' }
      ]}
    />

    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <div class="w-full lg:w-[68%] min-w-0">
        <!-- Search Header Box -->
        <div class="p-6 mb-8 bg-white rounded-2xl border border-slate-200 shadow-2xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-600">Search Archive</span>
            {query && (
              <>
                <span class="text-slate-300">&bull;</span>
                <span class="text-xs text-slate-500 font-mono">{total} Matches Found</span>
              </>
            )}
          </div>

          <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-4">
            {query ? `Results for "${query}"` : 'Search Articles'}
          </h1>

          <form action="/search" method="get" class="flex gap-2">
            <div class="relative flex-1">
              <input
                type="search"
                name="q"
                value={query}
                placeholder="Type your search query..."
                required
                class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-hidden focus:border-indigo-600 transition"
              />
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 bg-indigo-900 text-white rounded-lg text-sm font-semibold hover:bg-indigo-800 transition cursor-pointer shrink-0"
            >
              Search
            </button>
          </form>
        </div>

        {query ? (
          posts.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <EmptyState
              title="No Matching Articles Found"
              message={`We couldn't find any articles matching "${query}". Try searching with different keywords.`}
              icon="search"
              showSearch={false}
              primaryAction={{ label: 'Return to Portal', href: '/' }}
              secondaryAction={{ label: 'Browse All Blogs', href: '/blogs' }}
            />
          )
        ) : (
          <div class="p-8 text-center bg-white rounded-2xl border border-slate-200">
            <p class="text-slate-500 text-xs">
              Enter a search query in the box above to find articles.
            </p>
          </div>
        )}

        {query && (
          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl="/search"
            searchParams={{ q: query }}
          />
        )}
      </div>

      <div class="w-full lg:w-[32%] shrink-0">
        <Sidebar />
      </div>
    </div>
  </div>
</BaseLayout>
