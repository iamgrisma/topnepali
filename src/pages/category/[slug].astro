---
// [slug].astro (Category Archive) — Dynamic SSR Category Archive for TopNepali
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Pagination from '../../components/Pagination.astro';
import { getCategoryBySlug, getPosts } from '../../lib/wp';

const rawSlug = Astro.params.slug || '';
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

const category = cleanSlug ? await getCategoryBySlug(cleanSlug) : null;
if (!category) {
  Astro.response.status = 404;
}

// Dynamic pagination
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

// Fetch posts in this category if category exists
let posts: any[] = [];
let total = 0;
let totalPages = 0;

if (category) {
  const postsResult = await getPosts({
    category: category.id,
    page: currentPage,
    perPage,
  });
  posts = postsResult.data;
  total = postsResult.total;
  totalPages = postsResult.totalPages;
}
---

<BaseLayout
  title={category ? `${category.name} Archives — Top Nepali` : 'Category Not Found — Top Nepali'}
  description={category?.description || `Articles and updates categorized under ${category?.name || cleanSlug} on Top Nepali.`}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span>/</span>
      <span class="text-slate-400">Category</span>
      <span>/</span>
      <span class="text-slate-900 font-semibold">{category ? category.name : 'Not Found'}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- Primary Content Area -->
      <div class="w-full lg:w-[68%] min-w-0">
        {!category ? (
          <div class="p-8 sm:p-12 text-center bg-white rounded-xl border border-slate-200 shadow-2xs">
            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                <line x1="12" y1="11" x2="12" y2="17" />
                <line x1="9" y1="14" x2="15" y2="14" />
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Category Not Found</h1>
            <p class="text-slate-600 text-sm max-w-md mx-auto mb-6">
              The category "{cleanSlug}" does not exist in our system or may have been renamed.
            </p>
            <form action="/search" method="get" class="max-w-md mx-auto mb-6">
              <div class="relative flex items-center">
                <input
                  type="search"
                  name="q"
                  placeholder="Search articles on Top Nepali..."
                  required
                  class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-4 pr-10 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-indigo-600 transition"
                />
                <button
                  type="submit"
                  class="absolute right-2 p-1.5 text-slate-400 hover:text-indigo-600 transition"
                  aria-label="Search"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                </button>
              </div>
            </form>
            <div class="flex items-center justify-center gap-3">
              <a href="/" class="px-5 py-2.5 bg-indigo-900 text-white rounded-lg text-xs font-semibold hover:bg-indigo-800 transition">
                Return to Homepage
              </a>
              <a href="/search" class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-50 transition">
                Search Articles
              </a>
            </div>
          </div>
        ) : (
          <>
            <!-- Category Archive Header -->
            <header class="p-6 mb-8 bg-white rounded-xl border border-slate-200 shadow-2xs">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-600">Category Archive</span>
                <span class="text-slate-300">&bull;</span>
                <span class="text-xs text-slate-500 font-mono">{total} Articles</span>
              </div>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
                {category.name}
              </h1>
              {category.description && (
                <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                  {category.description}
                </p>
              )}
            </header>

            <!-- Posts Grid -->
            {posts.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {posts.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            ) : (
              <div class="p-8 text-center bg-white rounded-xl border border-slate-200">
                <p class="text-slate-600 text-sm">
                  No articles found in this category yet.
                </p>
                <a href="/" class="mt-3 inline-block text-xs font-semibold text-indigo-600 hover:underline">
                  Browse All Articles
                </a>
              </div>
            )}

            <!-- Dynamic Pagination -->
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              baseUrl={`/category/${cleanSlug}`}
            />
          </>
        )}
      </div>

      <!-- Right Sidebar -->
      <div class="w-full lg:w-[32%] shrink-0">
        <Sidebar />
      </div>

    </div>
  </div>
</BaseLayout>
