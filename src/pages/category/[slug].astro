---
// [slug].astro (Category Archive) — Dynamic SSR Category Archive for TopNepali
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Pagination from '../../components/Pagination.astro';
import { getCategoryBySlug, getPosts } from '../../lib/wp';

const { slug } = Astro.params;
if (!slug) {
  return new Response('Category slug required', { status: 400 });
}

// Fetch category details
const category = await getCategoryBySlug(slug);
if (!category) {
  return new Response('Category not found', { status: 404 });
}

// Dynamic pagination
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

// Fetch posts in this category
const postsResult = await getPosts({
  category: category.id,
  page: currentPage,
  perPage,
});

const { data: posts, total, totalPages } = postsResult;
---

<BaseLayout
  title={`${category.name} Archives — Top Nepali`}
  description={category.description || `Articles and updates categorized under ${category.name} on Top Nepali.`}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span>/</span>
      <span class="text-slate-400">Category</span>
      <span>/</span>
      <span class="text-slate-900 font-semibold">{category.name}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- Primary Content Area -->
      <div class="w-full lg:w-[68%] min-w-0">
        
        <!-- Category Archive Header -->
        <header class="p-6 mb-8 bg-white rounded-xl border border-slate-200 shadow-2xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-600">Category Archive</span>
            <span class="text-slate-300">&bull;</span>
            <span class="text-xs text-slate-500 font-mono">{total} Articles</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            {category.name}
          </h1>
          {category.description && (
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              {category.description}
            </p>
          )}
        </header>

        <!-- Posts Grid -->
        {posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="p-8 text-center bg-white rounded-xl border border-slate-200">
            <p class="text-slate-600 text-sm">
              No articles found in this category yet.
            </p>
            <a href="/" class="mt-3 inline-block text-xs font-semibold text-indigo-600 hover:underline">
              Browse All Articles
            </a>
          </div>
        )}

        <!-- Dynamic Pagination -->
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          baseUrl={`/category/${slug}`}
        />
      </div>

      <!-- Right Sidebar -->
      <div class="w-full lg:w-[32%] shrink-0">
        <Sidebar />
      </div>

    </div>
  </div>
</BaseLayout>
