---
// [slug].astro (Category Archive) — Dynamic SSR Category Archive for TopNepali
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Pagination from '../../components/Pagination.astro';
import { getCategoryBySlug, getPosts, getAllCategories, DEFAULT_TOP_CATEGORIES } from '../../lib/wp';

const rawSlug = Astro.params.slug || '';
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

const category = cleanSlug ? await getCategoryBySlug(cleanSlug) : null;
if (!category) {
  Astro.response.status = 404;
}

// Dynamic pagination
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

// Fetch posts in this category (includes all subcategories)
let posts: any[] = [];
let total = 0;
let totalPages = 0;

if (category) {
  const postsResult = await getPosts({
    category: category.id,
    page: currentPage,
    perPage,
  });
  posts = postsResult.data;
  total = postsResult.total;
  totalPages = postsResult.totalPages;
}

const allCategories = await getAllCategories();
const childCategories = category ? allCategories.filter((c) => c.parent === category.id) : [];
const parentCategory = (category && category.parent > 0) ? allCategories.find((c) => c.id === category.parent) : null;
const otherCategories = DEFAULT_TOP_CATEGORIES.filter((c) => c.slug !== cleanSlug).slice(0, 6);
---

<BaseLayout
  title={category ? `${category.name} Archives — Top Nepali` : 'Category Not Found — Top Nepali'}
  description={category?.description || `Verified articles, news, and official updates categorized under ${category?.name || cleanSlug} on Top Nepali.`}
  canonicalUrl={currentPage > 1 ? `https://topnepali.com/category/${cleanSlug}?page=${currentPage}` : `https://topnepali.com/category/${cleanSlug}`}
  robots={!category ? 'noindex, nofollow' : undefined}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-indigo-600 transition">Portal Home</a>
      <span>/</span>
      <a href="/blogs" class="hover:text-indigo-600 transition">Blogs</a>
      <span>/</span>
      <span class="text-slate-400">Category</span>
      {parentCategory && (
        <>
          <span>/</span>
          <a href={`/category/${parentCategory.slug}`} class="hover:text-indigo-600 transition">{parentCategory.name}</a>
        </>
      )}
      <span>/</span>
      <span class="text-slate-900 font-semibold">{category ? category.name : 'Not Found'}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 items-start">
      
      <!-- Primary Content Area -->
      <div class="w-full lg:w-[68%] min-w-0">
        {!category ? (
          <div class="p-8 sm:p-12 text-center bg-white rounded-2xl border border-slate-200 shadow-2xs">
            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                <line x1="12" y1="11" x2="12" y2="17" />
                <line x1="9" y1="14" x2="15" y2="14" />
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Category Not Located</h1>
            <p class="text-slate-600 text-sm max-w-md mx-auto mb-6">
              The category "{cleanSlug}" does not exist in our archive or may have been consolidated.
            </p>
            <form action="/search" method="get" class="max-w-md mx-auto mb-6">
              <div class="relative flex items-center">
                <input
                  type="search"
                  name="q"
                  placeholder="Search articles on Top Nepali..."
                  required
                  class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-4 pr-10 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-hidden focus:border-indigo-600 transition"
                />
                <button
                  type="submit"
                  class="absolute right-2 p-1.5 text-slate-400 hover:text-indigo-600 transition"
                  aria-label="Search"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                </button>
              </div>
            </form>
            <div class="flex items-center justify-center gap-3">
              <a href="/blogs" class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg text-xs font-semibold hover:bg-indigo-700 transition">
                Browse All Blogs
              </a>
              <a href="/" class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-50 transition">
                Return to Portal
              </a>
            </div>
          </div>
        ) : (
          <>
            <!-- Minimalist Category Archive Header -->
            <header class="p-6 sm:p-8 mb-8 bg-white rounded-2xl border border-slate-200 shadow-2xs">
              <div class="flex items-center justify-between gap-4 mb-3">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                  <span>Category Vertical</span>
                </div>
                <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200/80">
                  {total} {total === 1 ? 'Article' : 'Articles'}
                </span>
              </div>

              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mb-2">
                {category.name}
              </h1>

              <p class="text-sm text-slate-600 leading-relaxed max-w-2xl">
                {category.description || `Curated editorial insights, exam notifications, and civic information filed under ${category.name}.`}
              </p>

              {childCategories.length > 0 && (
                <nav class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-2 flex-wrap text-xs" aria-label="Subcategories">
                  <span class="text-slate-500 font-semibold uppercase tracking-wider shrink-0 mr-1 text-[11px]">Subcategories:</span>
                  {childCategories.map((child) => (
                    <a
                      href={`/category/${child.slug}`}
                      class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 hover:bg-indigo-100 font-medium transition"
                    >
                      <span>{child.name}</span>
                      <span class="text-indigo-400 font-mono text-[11px]">({child.count})</span>
                    </a>
                  ))}
                </nav>
              )}

              <!-- Related Category Chips -->
              <nav class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2 overflow-x-auto pb-1 text-xs" aria-label="Explore other categories">
                <span class="text-slate-400 font-medium shrink-0 mr-1">Other Topics:</span>
                {otherCategories.map((c) => (
                  <a
                    href={`/category/${c.slug}`}
                    class="shrink-0 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 font-medium transition"
                  >
                    {c.name}
                  </a>
                ))}
              </nav>
            </header>

            <!-- Posts Stream -->
            {posts.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {posts.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            ) : (
              <div class="p-8 text-center bg-white rounded-2xl border border-slate-200">
                <p class="text-slate-600 text-sm">
                  No articles found in this category yet.
                </p>
                <a href="/blogs" class="mt-3 inline-block text-xs font-semibold text-indigo-600 hover:underline">
                  Browse All Articles
                </a>
              </div>
            )}

            <!-- Dynamic Pagination -->
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              baseUrl={`/category/${cleanSlug}`}
            />
          </>
        )}
      </div>

      <!-- Right Sidebar -->
      <div class="w-full lg:w-[32%] shrink-0">
        <Sidebar recentPosts={posts} />
      </div>

    </div>
  </div>
</BaseLayout>
