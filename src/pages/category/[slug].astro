---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveStream from '../../components/ArchiveStream.astro';
import EmptyState from '../../components/EmptyState.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCategoryBySlug, getPosts, getAllCategories, DEFAULT_TOP_CATEGORIES } from '../../lib/wp';

const rawSlug = Astro.params.slug || '';
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

const category = cleanSlug ? await getCategoryBySlug(cleanSlug) : null;
if (!category) {
  Astro.response.status = 404;
}

const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? Math.max(1, parseInt(pageParam, 10) || 1) : 1;
const perPage = 10;

let posts: any[] = [];
let total = 0;
let totalPages = 0;

if (category) {
  const postsResult = await getPosts({
    category: category.id,
    page: currentPage,
    perPage,
  });
  posts = postsResult.data;
  total = postsResult.total;
  totalPages = postsResult.totalPages;
}

const allCategories = await getAllCategories();
const childCategories = category ? allCategories.filter((c) => c.parent === category.id) : [];
const parentCategory = (category && category.parent > 0) ? allCategories.find((c) => c.id === category.parent) : null;
const otherCategories = DEFAULT_TOP_CATEGORIES.filter((c) => c.slug !== cleanSlug).slice(0, 6);

const breadcrumbs = [
  { label: 'Portal Home', href: '/' },
  { label: 'Blogs', href: '/blogs' },
  { label: 'Category' },
  ...(parentCategory ? [{ label: parentCategory.name, href: `/category/${parentCategory.slug}` }] : []),
  { label: category ? category.name : 'Not Found' },
];

const subCategoryChips = childCategories.map((child) => ({
  name: child.name,
  href: `/category/${child.slug}`,
  count: child.count,
}));

const topicChips = otherCategories.map((c) => ({
  name: c.name,
  href: `/category/${c.slug}`,
}));
---

<BaseLayout
  title={category ? `${category.name} Archives | Top Nepali` : 'Category Not Found | Top Nepali'}
  description={category?.description || `Verified articles, news, and official updates categorized under ${category?.name || cleanSlug} on Top Nepali.`}
  canonicalUrl={currentPage > 1 ? `https://topnepali.com/category/${cleanSlug}?page=${currentPage}` : `https://topnepali.com/category/${cleanSlug}`}
  robots={!category ? 'noindex, nofollow' : undefined}
  categoryFeedUrl={category ? `/category/${cleanSlug}/feed` : undefined}
  categoryFeedTitle={category ? `${category.name} Feed | Top Nepali` : undefined}
>
  {!category ? (
    <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-10">
      <Breadcrumb
        items={[
          { label: 'Portal Home', href: '/' },
          { label: 'Blogs', href: '/blogs' },
          { label: 'Category Not Found' }
        ]}
      />
      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <div class="w-full lg:w-[68%] min-w-0">
          <EmptyState
            title="Category Not Located"
            message={`The category "${cleanSlug}" does not exist in our archive or may have been consolidated.`}
            icon="folder"
            primaryAction={{ label: 'Browse All Blogs', href: '/blogs' }}
            secondaryAction={{ label: 'Return to Portal', href: '/' }}
          />
        </div>
        <div class="w-full lg:w-[32%] shrink-0">
          <Sidebar />
        </div>
      </div>
    </div>
  ) : (
    <ArchiveStream
      badgeLabel="Category Vertical"
      heading={category.name}
      description={category.description || `Curated editorial insights, exam notifications, and civic information filed under ${category.name}.`}
      total={total}
      breadcrumbs={breadcrumbs}
      subCategories={subCategoryChips}
      topicChips={topicChips}
      topicChipsLabel="Other Topics:"
      posts={posts}
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl={`/category/${cleanSlug}`}
      emptyMessage="No articles found in this category yet."
    />
  )}
</BaseLayout>
