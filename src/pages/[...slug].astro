            if (name && /Sub-Metropolitan/i.test(name) && /^\d/.test(area)) {
              const key = name.toLowerCase();
              if (!seen.has(key)) {
                seen.add(key);
                items.push({
                  name,
                  district: distProv,
                  province: distProv.split('(')[1]?.replace(')', '').trim() || '',
                  area: area + ' km²',
