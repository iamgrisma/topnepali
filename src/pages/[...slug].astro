---
// [...slug].astro — Universal SSR Dynamic Post & Page Reader for TopNepali
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import {
  getPostBySlug,
  getPageBySlug,
  getPosts,
  getRecentPosts,
  formatDate,
  estimateReadingTime,
  getPostFeaturedImage,
  getPostAuthor,
  getPostCategories,
  getPostTags,
  stripHtml,
  optimizeWpHtml
} from '../lib/wp';

const rawSlug = Astro.params.slug;
if (!rawSlug) {
  Astro.response.status = 404;
  return;
}

// Clean slug (handles any trailing slash without HTTP redirect)
const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

// Known static pages list to avoid sending duplicate post+page queries to WordPress
const KNOWN_PAGES = new Set([
  'about', 'about-us', 'contact', 'contact-us', 'privacy-policy', 'privacy',
  'terms', 'terms-and-conditions', 'disclaimer', 'dmca', 'sitemap'
]);

let post = null;
let page = null;

if (KNOWN_PAGES.has(cleanSlug.toLowerCase())) {
  page = await getPageBySlug(cleanSlug);
} else {
  post = await getPostBySlug(cleanSlug);
  if (!post) {
    page = await getPageBySlug(cleanSlug);
  }
}

// If neither exists, render 404 without redirect
if (!post && !page) {
  Astro.response.status = 404;
}

// Prepare post metadata
const isArticle = Boolean(post);
const item = post || page;

// 1. Title: Prefer Rank Math SEO title if present, fallback to post title
const seoTitle = item?.seo?.title;
const rawTitle = seoTitle || (item ? item.title.rendered : 'Page Not Found');
const title = rawTitle.includes('Top Nepali') ? rawTitle : `${rawTitle} — Top Nepali`;

// 2. Description: Prefer Rank Math SEO description, fallback to post excerpt
const fallbackExcerpt = item ? stripHtml(item.excerpt?.rendered || item.content?.rendered || '').slice(0, 160) : 'The requested page could not be found.';
const description = item?.seo?.description || fallbackExcerpt;

// 3. Featured Image / OG Image
const featuredImg = item ? getPostFeaturedImage(item) : null;
const ogImage = item?.seo?.og_image || featuredImg?.url || 'https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png';

// 4. Canonical URL: Prefer Rank Math canonical URL, fallback to site canonical
const canonicalUrl = item?.seo?.canonical_url || (item ? `https://topnepali.com/${cleanSlug}` : undefined);

// 5. Author, Categories, Tags & Dates
const author = post ? getPostAuthor(post) : null;
const categories = post ? getPostCategories(post) : [];
const tags = post ? getPostTags(post) : [];
const primaryCategory = categories[0];
const readingTime = item ? estimateReadingTime(item.content?.rendered || '') : '';
const publishedTime = post?.date;
const modifiedTime = post?.modified;
const robots = typeof item?.seo?.robots === 'string' ? item.seo.robots : null;
const headHtml = item?.head || null;

// Fetch related posts and recent posts in parallel (eliminates sequential API waterfall)
const [relResult, recentPosts] = await Promise.all([
  (post && primaryCategory)
    ? getPosts({ category: primaryCategory.id, perPage: 3, exclude: [post.id] })
    : Promise.resolve({ data: [] }),
  getRecentPosts(6),
]);
const relatedPosts = relResult.data;

const currentUrl = Astro.url.href;
---

{(!post && !page) ? (
  <BaseLayout title="404 — Page Not Found | Top Nepali" description="The page you were looking for could not be found.">
    <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-indigo-600">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold">404 Not Found</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <!-- Primary Content Area -->
        <div class="w-full lg:w-[68%] min-w-0">
          <div class="p-8 sm:p-12 text-center bg-white rounded-xl border border-slate-200 shadow-2xs">
            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">404 — Page Not Found</h1>
            <p class="text-slate-600 text-sm max-w-md mx-auto mb-6">
              The article or page "{cleanSlug}" could not be located in the TopNepali digital archive. It may have been moved, renamed, or is temporarily unavailable.
            </p>

            <!-- Search form -->
            <form action="/search" method="get" class="max-w-md mx-auto mb-6">
              <div class="relative flex items-center">
                <input
                  type="search"
                  name="q"
                  placeholder="Search articles on Top Nepali..."
                  required
                  class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-4 pr-10 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-indigo-600 transition"
                />
                <button
                  type="submit"
                  class="absolute right-2 p-1.5 text-slate-400 hover:text-indigo-600 transition"
                  aria-label="Search"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                </button>
              </div>
            </form>

            <div class="flex items-center justify-center gap-3">
              <a href="/" class="px-5 py-2.5 bg-indigo-900 text-white rounded-lg text-xs font-semibold hover:bg-indigo-800 transition">
                Return to Homepage
              </a>
              <a href="/search" class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-50 transition">
                Search Articles
              </a>
            </div>
          </div>
        </div>

        <!-- Right Sidebar -->
        <div class="w-full lg:w-[32%] shrink-0">
          <Sidebar />
        </div>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={title}
    description={description}
    image={ogImage}
    type={isArticle ? 'article' : 'website'}
    canonicalUrl={canonicalUrl}
    headHtml={headHtml}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    authorName={author?.name}
    section={primaryCategory?.name}
    robots={robots}
  >
    <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-indigo-600">Home</a>
        <span>/</span>
        {primaryCategory && (
          <>
            <a href={`/category/${primaryCategory.slug}`} class="hover:text-indigo-600">
              {primaryCategory.name}
            </a>
            <span>/</span>
          </>
        )}
        <span class="text-slate-800 font-medium truncate max-w-xs sm:max-w-md">
          {title}
        </span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        
        <!-- Primary Article Container -->
        <article class="w-full lg:w-[68%] min-w-0 bg-white rounded-xl border border-slate-200 shadow-2xs p-5 sm:p-8">
          
          <!-- Category Badge -->
          {primaryCategory && (
            <div class="mb-3">
              <a
                href={`/category/${primaryCategory.slug}`}
                class="inline-block text-[11px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md hover:bg-indigo-100 transition"
              >
                {primaryCategory.name}
              </a>
            </div>
          )}

          <!-- Headline -->
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-4 tracking-tight">
            {title}
          </h1>

          <!-- Meta Bar (Author, Date, Reading Time) -->
          {isArticle && author && post && (
            <div class="flex flex-wrap items-center justify-between gap-4 py-3.5 mb-6 border-y border-slate-100 text-xs text-slate-500">
              <div class="flex items-center gap-3">
                {author.avatar ? (
                  <img
                    src={author.avatar}
                    alt={author.name}
                    class="w-9 h-9 rounded-full object-cover border border-slate-200"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold">
                    {author.name.charAt(0)}
                  </div>
                )}
                <div>
                  <span class="font-semibold text-slate-900 block">
                    {author.name}
                  </span>
                  <div class="flex items-center gap-2 text-[11px] text-slate-400">
                    <time datetime={post.date}>{formatDate(post.date)}</time>
                    <span>&bull;</span>
                    <span>{readingTime}</span>
                  </div>
                </div>
              </div>

              <!-- Share Quick Trigger -->
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="share-copy-btn"
                  class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium flex items-center gap-1.5 transition cursor-pointer"
                  data-url={currentUrl}
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                    <polyline points="16 6 12 2 8 6" />
                    <line x1="12" y1="2" x2="12" y2="15" />
                  </svg>
                  <span id="share-btn-text">Share</span>
                </button>
              </div>
            </div>
          )}

          <!-- Featured Media Banner -->
          {featuredImg && (
            <figure class="mb-8 rounded-lg overflow-hidden border border-slate-200 bg-slate-50">
              <img
                src={featuredImg.url}
                alt={featuredImg.alt}
                class="w-full h-auto max-h-[480px] object-cover mx-auto"
                loading="eager"
              />
              {featuredImg.alt && featuredImg.alt !== title && (
                <figcaption class="p-2 text-center text-xs text-slate-400">
                  {featuredImg.alt}
                </figcaption>
              )}
            </figure>
          )}

          <!-- Dynamic WordPress Content (Sanitized & Debloated) -->
          <div class="entry-content mb-8" set:html={optimizeWpHtml(item?.content?.rendered || '')} />

          <!-- Tags List -->
          {tags.length > 0 && (
            <div class="pt-6 border-t border-slate-100 mb-8">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2.5">
                Related Tags
              </span>
              <div class="flex flex-wrap gap-1.5">
                {tags.map((t) => (
                  <a
                    href={`/tag/${t.slug}`}
                    class="px-2.5 py-1 text-xs rounded-md bg-slate-100 text-slate-600 hover:bg-slate-200 transition"
                  >
                    #{t.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Author Bio Box -->
          {author && isArticle && (
            <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-start gap-4 mb-8">
              {author.avatar ? (
                <img
                  src={author.avatar}
                  alt={author.name}
                  class="w-12 h-12 rounded-full object-cover shrink-0 border border-slate-200"
                  loading="lazy"
                />
              ) : (
                <div class="w-12 h-12 rounded-full bg-indigo-100 text-indigo-600 font-bold flex items-center justify-center shrink-0">
                  {author.name.charAt(0)}
                </div>
              )}
              <div>
                <h3 class="font-bold text-sm text-slate-900 mb-1">
                  Written by {author.name}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {author.description || 'Contributing editorial writer at Top Nepali covering national updates, education routines, and civic information.'}
                </p>
              </div>
            </div>
          )}

          <!-- Related Posts Section -->
          {relatedPosts.length > 0 && (
            <div class="pt-8 border-t border-slate-100">
              <h3 class="font-bold text-base text-slate-900 mb-4">
                You May Also Like
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {relatedPosts.map((rel) => {
                  const relImg = getPostFeaturedImage(rel);
                  return (
                    <a
                      href={`/${rel.slug}`}
                      class="group block p-3 rounded-lg border border-slate-100 hover:border-indigo-400 transition"
                    >
                      {relImg ? (
                        <div class="aspect-video rounded-md overflow-hidden bg-slate-100 mb-2">
                          <img
                            src={relImg.url}
                            alt={relImg.alt}
                            class="w-full h-full object-cover group-hover:scale-105 transition duration-200"
                            loading="lazy"
                          />
                        </div>
                      ) : null}
                      <h4 class="font-semibold text-xs text-slate-800 group-hover:text-indigo-600 line-clamp-2 leading-snug">
                        {rel.title.rendered}
                      </h4>
                      <time class="text-[10px] text-slate-400 block mt-1">
                        {formatDate(rel.date)}
                      </time>
                    </a>
                  );
                })}
              </div>
            </div>
          )}

        </article>

        <!-- Right Sidebar -->
        <div class="w-full lg:w-[32%] shrink-0">
          <Sidebar excludePostId={post?.id} recentPosts={recentPosts} />
        </div>

      </div>
    </div>

    <!-- Script for copy/share functionality -->
    <script>
      function setupShare() {
        const btn = document.getElementById('share-copy-btn');
        const text = document.getElementById('share-btn-text');
        if (!btn || !text) return;

        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url') || window.location.href;
          if (navigator.share) {
            try {
              await navigator.share({
                title: document.title,
                url: url,
              });
              return;
            } catch (err) {
              // fallback to copy
            }
          }

          if (navigator.clipboard) {
            await navigator.clipboard.writeText(url);
            text.textContent = 'Copied!';
            setTimeout(() => {
              text.textContent = 'Share';
            }, 2000);
          }
        });
      }

      setupShare();
      document.addEventListener('astro:page-load', setupShare);
    </script>
  </BaseLayout>
)}
