            const hq = cells[1].textContent?.trim() || '';
            const std = cells[2].textContent?.trim() || '';
            const intl = cells[3]?.textContent?.trim() || '';
            if (/^\d{2,3}$/.test(std) || /^0\d{1,2}$/.test(std)) {
              const key = `${name.toLowerCase()}_${std}`;
              if (!seen.has(key)) {
                seen.add(key);
                items.push({
                  title: `${name} District (${hq})`,
                  subtitle: intl ? `International: ${intl}` : 'Nepal STD Area Code',
                  code: std,
                  intl: intl,
