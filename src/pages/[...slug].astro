---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  getPostBySlug,
  getPageBySlug,
  getPosts,
  getRecentPosts,
  formatDate,
  estimateReadingTime,
  getPostFeaturedImage,
  getPostAuthor,
  getPostCategories,
  getPostTags,
  getPostTitle,
  stripHtml,
  decodeHtmlEntities,
  optimizeWpHtml,
  resolveRankMathVariables,
  getAllCategories,
  getRankMathRedirection,
} from '../lib/wp';

const rawSlug = Astro.params.slug;
if (!rawSlug) {
  Astro.response.status = 404;
  return;
}

const cleanSlug = rawSlug.replace(/^\/+|\/+$/g, '');

const KNOWN_PAGES = new Set([
  'about', 'about-us', 'contact', 'contact-us', 'privacy-policy', 'privacy',
  'terms', 'terms-and-conditions', 'disclaimer', 'dmca', 'sitemap'
]);

const isKnownPage = KNOWN_PAGES.has(cleanSlug.toLowerCase());

const [rmRedirect, initialContent] = await Promise.all([
  getRankMathRedirection(cleanSlug),
  isKnownPage ? getPageBySlug(cleanSlug) : getPostBySlug(cleanSlug),
]);

let post = isKnownPage ? null : initialContent;
let page = isKnownPage ? initialContent : null;

if (!post && !page && !isKnownPage) {
  page = await getPageBySlug(cleanSlug);
}

// In-memory alias / redirect rewrite: If Rank Math configured a redirection, fetch target in-memory with zero HTTP redirect hops
const redirectTarget = rmRedirect?.redirect_url || (post || page)?.seo?.redirect_url;
if ((!post && !page) && redirectTarget) {
  const cleanTargetSlug = redirectTarget
    .replace(/^https?:\/\/(?:wp\.)?topnepali\.com/i, '')
    .replace(/^\/+|\/+$/g, '');
  if (cleanTargetSlug && cleanTargetSlug !== cleanSlug) {
    post = await getPostBySlug(cleanTargetSlug);
    if (!post) {
      page = await getPageBySlug(cleanTargetSlug);
    }
  }
}

if (!post && !page) {
  Astro.response.status = 404;
}

const isArticle = Boolean(post);
const item = post || page;

const author = post ? getPostAuthor(post) : null;
const categories = post ? getPostCategories(post) : [];
const tags = post ? getPostTags(post) : [];
const primaryCategory = categories[0];
const allCategories = await getAllCategories();
const fullPrimary = primaryCategory ? allCategories.find((ac) => ac.id === primaryCategory.id || ac.slug === primaryCategory.slug) : null;
const parentCategory = (fullPrimary && fullPrimary.parent > 0) ? allCategories.find((p) => p.id === fullPrimary.parent) : null;

const cleanPostTitle = item ? getPostTitle(item) : 'Page Not Found';

let resolvedSeoTitle = resolveRankMathVariables(item?.seo?.title, {
  title: cleanPostTitle,
  siteName: 'Top Nepali',
  separator: '—',
  category: primaryCategory?.name,
});

if (!resolvedSeoTitle || !resolvedSeoTitle.replace(/[\(\)\[\]\-\—\s\|\:\,]/g, '').trim()) {
  resolvedSeoTitle = cleanPostTitle;
}

const rawTitle = decodeHtmlEntities(resolvedSeoTitle || cleanPostTitle);
let cleanTitle = (rawTitle.includes('Top Nepali') ? rawTitle : `${rawTitle} — Top Nepali`).replace(/\((\d{4})\)\s*\(\1\)/gi, '($1)');
// Clean up repetitive trailing year when title already features that year (e.g. "(2026 Directory) ... 2026 — Top Nepali")
cleanTitle = cleanTitle.replace(/(\b(\d{4})\b.*?)\s+\2\s*([—\-\|]\s*Top Nepali)/gi, '$1 $3');
const title = cleanTitle;

const fallbackExcerpt = item ? stripHtml(item.excerpt?.rendered || item.content?.rendered || '').slice(0, 180) : 'The requested page could not be found.';
const resolvedSeoDesc = resolveRankMathVariables(item?.seo?.description, {
  title: cleanPostTitle,
  excerpt: fallbackExcerpt,
  siteName: 'Top Nepali',
  separator: '—',
  category: primaryCategory?.name,
});
// When Rank Math description is identical to title or unconfigured, fall back to rich author excerpt
const isRedundantDesc = !resolvedSeoDesc || 
  resolvedSeoDesc.trim().toLowerCase() === cleanPostTitle.trim().toLowerCase() ||
  resolvedSeoDesc.trim().toLowerCase() === decodeHtmlEntities(cleanPostTitle).trim().toLowerCase() ||
  resolvedSeoDesc.trim().length < 30;

const description = decodeHtmlEntities(isRedundantDesc && fallbackExcerpt ? fallbackExcerpt : (resolvedSeoDesc || fallbackExcerpt));

const featuredImg = item ? getPostFeaturedImage(item) : null;
const rawOgImage = item?.seo?.og_image || featuredImg?.url || 'https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png';
const ogImage = rawOgImage.replace(/https?:\/\/wp\.topnepali\.com/gi, 'https://topnepali.com');

const rawCanonical = item?.seo?.canonical_url;
const canonicalUrl = rawCanonical
  ? rawCanonical.replace(/https?:\/\/wp\.topnepali\.com/gi, 'https://topnepali.com')
  : (item ? `https://topnepali.com/${cleanSlug}` : undefined);

const readingTime = item ? estimateReadingTime(item) : '';
const publishedTime = post?.date;
const modifiedTime = post?.modified;
const robots = typeof item?.seo?.robots === 'string' ? item.seo.robots : null;

const headHtml = item?.head
  ? item.head.replace(/https?:\/\/wp\.topnepali\.com/gi, 'https://topnepali.com')
  : null;

const [relResult, recentPosts] = await Promise.all([
  (post && primaryCategory)
    ? getPosts({ category: primaryCategory.id, perPage: 3, exclude: [post.id] })
    : Promise.resolve({ data: [] }),
  getRecentPosts(6),
]);
const relatedPosts = relResult.data;

const currentUrl = Astro.url.href;
---

{(!post && !page) ? (
  <BaseLayout title="404 — Page Not Found | Top Nepali" description="The page you were looking for could not be found." robots="noindex, nofollow">
    <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-indigo-600 transition">Portal Home</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold">404 Not Found</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <div class="w-full lg:w-[68%] min-w-0">
          <EmptyState
            title="404 — Page Not Found"
            message={`The article or page "${cleanSlug}" could not be located in the TopNepali digital archive. It may have been moved, renamed, or is temporarily unavailable.`}
            icon="file-question"
            primaryAction={{ label: 'Return to Portal', href: '/' }}
            secondaryAction={{ label: 'Browse All Blogs', href: '/blogs' }}
          />
        </div>
        <div class="w-full lg:w-[32%] shrink-0">
          <Sidebar />
        </div>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={title}
    description={description}
    image={ogImage}
    type={isArticle ? 'article' : 'website'}
    canonicalUrl={canonicalUrl}
    headHtml={headHtml}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    authorName={author?.name}
    section={primaryCategory?.name}
    robots={robots}
  >
    <div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-indigo-600 transition">Home</a>
        <span>/</span>
        {parentCategory && (
          <>
            <a href={`/category/${parentCategory.slug}`} class="hover:text-indigo-600 transition">
              {parentCategory.name}
            </a>
            <span>/</span>
          </>
        )}
        {primaryCategory && (
          <>
            <a href={`/category/${primaryCategory.slug}`} class="hover:text-indigo-600 transition">
              {primaryCategory.name}
            </a>
            <span>/</span>
          </>
        )}
        <span class="text-slate-800 font-medium truncate max-w-xs sm:max-w-md">
          {title}
        </span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <!-- Primary Article Container -->
        <article class="w-full lg:w-[68%] min-w-0 bg-white rounded-xl border border-slate-200 shadow-2xs p-5 sm:p-8">
          {primaryCategory && (
            <div class="mb-3">
              <a
                href={`/category/${primaryCategory.slug}`}
                class="inline-block text-[11px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md hover:bg-indigo-100 transition"
              >
                {primaryCategory.name}
              </a>
            </div>
          )}

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-4 tracking-tight">
            {cleanPostTitle}
          </h1>

          {isArticle && author && post && (
            <div class="flex flex-wrap items-center justify-between gap-4 py-3.5 mb-6 border-y border-slate-100 text-xs text-slate-500">
              <div class="flex items-center gap-3">
                {author.avatar ? (
                  <img
                    src={author.avatar}
                    alt={author.name}
                    class="w-9 h-9 rounded-full object-cover border border-slate-200"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold">
                    {author.name.charAt(0)}
                  </div>
                )}
                <div>
                  <span class="font-semibold text-slate-900 block">
                    {author.name}
                  </span>
                  <div class="flex items-center gap-2 text-[11px] text-slate-400">
                    <time datetime={post.date}>{formatDate(post.date)}</time>
                    <span>&bull;</span>
                    <span>{readingTime}</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="share-copy-btn"
                  class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium flex items-center gap-1.5 transition cursor-pointer"
                  data-url={currentUrl}
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                    <polyline points="16 6 12 2 8 6" />
                    <line x1="12" y1="2" x2="12" y2="15" />
                  </svg>
                  <span id="share-btn-text">Share</span>
                </button>
              </div>
            </div>
          )}

          {featuredImg && (
            <figure class="mb-8 rounded-lg overflow-hidden border border-slate-200 bg-slate-50">
              <img
                src={featuredImg.url}
                alt={featuredImg.alt}
                class="w-full h-auto max-h-[480px] object-cover mx-auto"
                loading="eager"
              />
              {featuredImg.alt && featuredImg.alt !== title && (
                <figcaption class="p-2 text-center text-xs text-slate-400">
                  {featuredImg.alt}
                </figcaption>
              )}
            </figure>
          )}

          <div class="entry-content mb-8" set:html={optimizeWpHtml(item?.content?.rendered || '')} />

          {tags.length > 0 && (
            <div class="pt-6 border-t border-slate-100 mb-8">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2.5">
                Related Tags
              </span>
              <div class="flex flex-wrap gap-1.5">
                {tags.map((t) => (
                  <a
                    href={`/tag/${t.slug}`}
                    class="px-2.5 py-1 text-xs rounded-md bg-slate-100 text-slate-600 hover:bg-slate-200 transition"
                  >
                    #{t.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          {author && isArticle && (
            <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-start gap-4 mb-8">
              {author.avatar ? (
                <img
                  src={author.avatar}
                  alt={author.name}
                  class="w-12 h-12 rounded-full object-cover shrink-0 border border-slate-200"
                  loading="lazy"
                />
              ) : (
                <div class="w-12 h-12 rounded-full bg-indigo-100 text-indigo-600 font-bold flex items-center justify-center shrink-0">
                  {author.name.charAt(0)}
                </div>
              )}
              <div>
                <h3 class="font-bold text-sm text-slate-900 mb-1">
                  Written by {author.name}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {author.description || 'Contributing editorial writer at Top Nepali covering national updates, education routines, and civic information.'}
                </p>
              </div>
            </div>
          )}

          {relatedPosts.length > 0 && (
            <div class="pt-8 border-t border-slate-100">
              <h3 class="font-bold text-base text-slate-900 mb-4">
                You May Also Like
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {relatedPosts.map((rel) => {
                  const relImg = getPostFeaturedImage(rel);
                  return (
                    <a
                      href={`/${rel.slug}`}
                      class="group block p-3 rounded-lg border border-slate-100 hover:border-indigo-400 transition"
                    >
                      {relImg ? (
                        <div class="aspect-video rounded-md overflow-hidden bg-slate-100 mb-2">
                          <img
                            src={relImg.url}
                            alt={relImg.alt}
                            class="w-full h-full object-cover group-hover:scale-105 transition duration-200"
                            loading="lazy"
                          />
                        </div>
                      ) : null}
                      <h4 class="font-semibold text-xs text-slate-800 group-hover:text-indigo-600 line-clamp-2 leading-snug">
                        {getPostTitle(rel)}
                      </h4>
                      <time class="text-[10px] text-slate-400 block mt-1">
                        {formatDate(rel.date)}
                      </time>
                    </a>
                  );
                })}
              </div>
            </div>
          )}
        </article>

        <!-- Right Sidebar -->
        <div class="w-full lg:w-[32%] shrink-0">
          <Sidebar excludePostId={post?.id} recentPosts={recentPosts} />
        </div>
      </div>
    </div>

    <script>
      function setupShare() {
        const btn = document.getElementById('share-copy-btn');
        const text = document.getElementById('share-btn-text');
        if (!btn || !text) return;

        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url') || window.location.href;
          if (navigator.share) {
            try {
              await navigator.share({
                title: document.title,
                url: url,
              });
              return;
            } catch {}
          }

          if (navigator.clipboard) {
            await navigator.clipboard.writeText(url);
            text.textContent = 'Copied!';
            setTimeout(() => {
              text.textContent = 'Share';
            }, 2000);
          }
        });
      }

      function setupPostalSearch() {
        const input = document.getElementById('postal-code-search-input') as HTMLInputElement | null;
        const resultsBox = document.getElementById('postal-search-results');
        const statusEl = document.getElementById('postal-search-status');
        if (!input || !resultsBox || !statusEl) return;

        interface PostalItem {
          location: string;
          district: string;
          code: string;
          keywords: string;
        }

        const items: PostalItem[] = [];
        const seen = new Set<string>();

        const aliases: PostalItem[] = [
          { location: 'Kathmandu (GPO Sundhara / New Road / Thamel / Baneshwor / Koteshwor)', district: 'Kathmandu', code: '44600', keywords: 'kathmandu baneshwor thamel new road maitighar tinkune sundhara gpo' },
          { location: 'Lalitpur (Patan / Jawalakhel / Kupondole / Pulchowk / Sanepa)', district: 'Lalitpur', code: '44700', keywords: 'lalitpur patan jawalakhel kupondole pulchowk sanepa lagankhel' },
          { location: 'Pokhara (Kaski DPO / Lakeside / Chipledhunga / Mahendrapool)', district: 'Kaski', code: '33700', keywords: 'pokhara kaski lakeside chipledhunga mahendrapool' },
          { location: 'Bharatpur / Narayangarh (Chitwan DPO)', district: 'Chitwan', code: '44200', keywords: 'bharatpur narayangarh chitwan' },
          { location: 'Biratnagar (Morang DPO)', district: 'Morang', code: '56600', keywords: 'biratnagar morang' },
          { location: 'Birgunj (Parsa DPO)', district: 'Parsa', code: '44300', keywords: 'birgunj parsa' },
          { location: 'Butwal (Rupandehi DPO)', district: 'Rupandehi', code: '32907', keywords: 'butwal rupandehi' },
          { location: 'Dharan (Sunsari DPO)', district: 'Sunsari', code: '56700', keywords: 'dharan sunsari' },
          { location: 'Nepalgunj (Banke DPO)', district: 'Banke', code: '21900', keywords: 'nepalgunj banke' },
          { location: 'Dhangadhi (Kailali DPO)', district: 'Kailali', code: '10900', keywords: 'dhangadhi kailali' }
        ];

        aliases.forEach(a => {
          items.push(a);
          seen.add(`${a.location.toLowerCase()}_${a.code}`);
        });

        document.querySelectorAll('.entry-content table tbody tr').forEach(row => {
          const cells = row.querySelectorAll('td');
          if (cells.length >= 2) {
            const loc = cells[0].textContent?.trim() || '';
            const code = cells[1].textContent?.trim() || '';
            if (/^\d{5}$/.test(code)) {
              const table = row.closest('table');
              let heading = table ? table.closest('figure')?.previousElementSibling : null;
              while (heading && !/^H3$/i.test(heading.tagName)) {
                heading = heading.previousElementSibling;
              }
              const dist = heading ? (heading.textContent || '').replace(/District/i, '').trim() : '';
              const key = `${loc.toLowerCase()}_${code}`;
              if (!seen.has(key)) {
                seen.add(key);
                items.push({
                  location: loc,
                  district: dist,
                  code: code,
                  keywords: `${loc} ${dist} ${code}`.toLowerCase()
                });
              }
            }
          }
        });

        let debounceTimer: ReturnType<typeof setTimeout>;
        input.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const query = input.value.trim().toLowerCase();
            if (query.length < 2) {
              resultsBox.classList.add('hidden');
              resultsBox.innerHTML = '';
              statusEl.classList.add('hidden');
              return;
            }

            const terms = query.split(/\s+/).filter(Boolean);
            const matches = items.filter(item => {
              const text = item.keywords || `${item.location} ${item.district} ${item.code}`.toLowerCase();
              return terms.every(t => text.includes(t));
            }).slice(0, 20);

            statusEl.classList.remove('hidden');
            if (matches.length === 0) {
              statusEl.textContent = `No postal codes found matching "${input.value}". Try searching by district name.`;
              resultsBox.classList.add('hidden');
              resultsBox.innerHTML = '';
              return;
            }

            statusEl.textContent = `Found ${matches.length} matching postal code${matches.length > 1 ? 's' : ''}:`;
            resultsBox.classList.remove('hidden');
            resultsBox.innerHTML = matches.map(m => `
              <div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl hover:border-indigo-300 transition shadow-2xs">
                <div>
                  <div class="font-bold text-xs sm:text-sm text-slate-900">${m.location}</div>
                  <div class="text-[11px] text-slate-500">${m.district ? m.district + ' District' : 'Nepal'}</div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono font-bold text-xs sm:text-sm px-2.5 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-md tracking-wider">${m.code}</span>
                  <button type="button" class="copy-postal-btn px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-slate-100 rounded-lg border border-slate-200 transition cursor-pointer" data-code="${m.code}">
                    Copy
                  </button>
                </div>
              </div>
            `).join('');

            resultsBox.querySelectorAll('.copy-postal-btn').forEach(btn => {
              btn.addEventListener('click', async () => {
                const code = btn.getAttribute('data-code');
                if (code && navigator.clipboard) {
                  await navigator.clipboard.writeText(code);
                  const orig = btn.textContent;
                  btn.textContent = 'Copied!';
                  btn.classList.add('bg-green-50', 'text-green-700', 'border-green-200');
                  setTimeout(() => {
                    btn.textContent = orig;
                    btn.classList.remove('bg-green-50', 'text-green-700', 'border-green-200');
                  }, 2000);
                }
              });
            });
          }, 150);
        });
      }

      setupShare();
      setupPostalSearch();
      document.addEventListener('astro:page-load', () => {
        setupShare();
        setupPostalSearch();
      });
    </script>
  </BaseLayout>
)}
