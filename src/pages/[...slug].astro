        });
      }

      function setupUniversalTableFilters() {
        document.querySelectorAll('input[data-table-filter], input.live-table-filter').forEach(rawInput => {
          const input = rawInput as HTMLInputElement;
          const targetSelector = input.getAttribute('data-table-filter') || input.getAttribute('data-table');
          if (!targetSelector) return;
          const table = document.querySelector(targetSelector);
          if (!table) return;

          const countTargetId = input.getAttribute('data-count-target');
          const countEl = countTargetId ? document.querySelector(countTargetId) : null;
          const clearBtnId = input.getAttribute('data-clear-target');
          const clearBtn = clearBtnId ? document.querySelector(clearBtnId) : null;

          const rows = Array.from(table.querySelectorAll('tbody tr'));
          const totalRows = rows.length;

          let debounceTimer: ReturnType<typeof setTimeout>;
          input.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
              const query = input.value.trim().toLowerCase();
              if (clearBtn) {
                clearBtn.classList.toggle('hidden', query.length === 0);
              }

              let visibleCount = 0;
              rows.forEach(row => {
                const text = (row.textContent || '').toLowerCase();
                const matches = query.length === 0 || text.includes(query);
                (row as HTMLElement).style.display = matches ? '' : 'none';
                if (matches) visibleCount++;
              });

              if (countEl) {
                if (query.length > 0) {
                  countEl.textContent = `Showing ${visibleCount} of ${totalRows} entries`;
                } else {
                  countEl.textContent = `Total: ${totalRows} entries`;
                }
              }
            }, 100);
          });

          if (clearBtn) {
            clearBtn.addEventListener('click', () => {
              input.value = '';
              input.dispatchEvent(new Event('input'));
              input.focus();
            });
          }
        });
      }

      function setupTocSmoothScroll() {
        document.querySelectorAll('.universal-toc a[href^="#"], .entry-content a[href^="#"]').forEach(link => {
          link.addEventListener('click', (e) => {
            const href = link.getAttribute('href');
            if (!href || href === '#') return;
            const targetId = href.slice(1);
            let target = document.getElementById(targetId);
            if (!target) {
              document.querySelectorAll('.entry-content h2, .entry-content h3').forEach(heading => {
                const slug = heading.textContent?.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
                if (slug === targetId) target = heading as HTMLElement;
              });
            }
            if (target) {
              e.preventDefault();
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.pushState(null, '', href);
            }
          });
        });
      }

      setupShare();
      setupPostalSearch();
      setupPhoneSearch();
      setupDistrictSearch();
      setupSubMetroSearch();
      setupUniversalTableFilters();
      setupTocSmoothScroll();
      document.addEventListener('astro:page-load', () => {
        setupShare();
        setupPostalSearch();
        setupPhoneSearch();
        setupDistrictSearch();
        setupSubMetroSearch();
        setupUniversalTableFilters();
        setupTocSmoothScroll();
      });
    </script>
  </BaseLayout>
