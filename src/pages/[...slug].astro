              resultsBox.classList.add('hidden');
              resultsBox.innerHTML = '';
              statusEl.classList.add('hidden');
              return;
            }

            const terms = query.split(/\s+/).filter(Boolean);
            const matches = items.filter(item => {
              const text = item.keywords || `${item.title} ${item.subtitle} ${item.code}`.toLowerCase();
              return terms.every(t => text.includes(t));
            }).slice(0, 20);

            statusEl.classList.remove('hidden');
            if (matches.length === 0) {
              statusEl.textContent = `No telephone codes found matching "${input.value}". Try searching by district name or city.`;
              resultsBox.classList.add('hidden');
              resultsBox.innerHTML = '';
              return;
            }

            statusEl.textContent = `Found ${matches.length} matching code${matches.length > 1 ? 's' : ''}:`;
            resultsBox.classList.remove('hidden');
            resultsBox.innerHTML = matches.map(m => `
              <div class="flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl hover:border-indigo-300 transition shadow-2xs">
                <div>
                  <div class="font-bold text-xs sm:text-sm text-slate-900">${m.title}</div>
                  <div class="text-[11px] text-slate-500">${m.subtitle}</div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono font-bold text-xs sm:text-sm px-2.5 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-md tracking-wider">${m.code}</span>
                  <button type="button" class="copy-phone-btn px-2.5 py-1 text-xs font-semibold text-slate-600 hover:text-indigo-600 hover:bg-slate-100 rounded-lg border border-slate-200 transition cursor-pointer" data-code="${m.code}">
                    Copy
                  </button>
                </div>
              </div>
            `).join('');

            resultsBox.querySelectorAll('.copy-phone-btn').forEach(btn => {
              btn.addEventListener('click', async () => {
                const code = btn.getAttribute('data-code');
                if (code && navigator.clipboard) {
                  await navigator.clipboard.writeText(code);
                  const orig = btn.textContent;
                  btn.textContent = 'Copied!';
                  btn.classList.add('bg-green-50', 'text-green-700', 'border-green-200');
                  setTimeout(() => {
                    btn.textContent = orig;
                    btn.classList.remove('bg-green-50', 'text-green-700', 'border-green-200');
                  }, 2000);
                }
              });
            });
          }, 150);
        });
      }

      function setupDistrictSearch() {
        const input = document.getElementById('district-search-input') as HTMLInputElement | null;
        const resultsBox = document.getElementById('district-search-results');
        const statusEl = document.getElementById('district-search-status');
        if (!input || !resultsBox || !statusEl) return;

        interface DistrictItem {
          name: string;
          hq: string;
          province: string;
          area: string;
          pop: string;
          keywords: string;
        }

        const items: DistrictItem[] = [];
        const seen = new Set<string>();

        document.querySelectorAll('.entry-content table tbody tr').forEach(row => {
          const cells = row.querySelectorAll('td');
          if (cells.length === 4) {
            const name = cells[0].textContent?.trim() || '';
            const hq = cells[1].textContent?.trim() || '';
            const area = cells[2].textContent?.trim() || '';
            const pop = cells[3].textContent?.trim() || '';
            if (name && hq && !/^Total/i.test(name) && !/^Rank/i.test(name) && /^\d/.test(area.replace(/,/g, '')) && /^\d/.test(pop.replace(/,/g, ''))) {
              const table = row.closest('table');
              let heading = table ? table.closest('figure')?.previousElementSibling : null;
              while (heading && !/^H2$/i.test(heading.tagName)) {
                heading = heading.previousElementSibling;
              }
              const prov = heading ? heading.textContent?.replace(/^Districts in\s*/i, '').replace(/\(.*?\)/g, '').trim() || 'Nepal' : 'Nepal';
              const key = name.toLowerCase();
              if (!seen.has(key)) {
                seen.add(key);
                items.push({
                  name,
                  hq,
                  province: prov,
                  area: area + ' km²',
                  pop: pop,
                  keywords: `${name} ${hq} ${prov}`.toLowerCase()
                });
              }
            }
          }
        });

        let debounceTimer: ReturnType<typeof setTimeout>;
        input.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const query = input.value.trim().toLowerCase();
            if (query.length < 2) {
              resultsBox.classList.add('hidden');
              resultsBox.innerHTML = '';
              statusEl.classList.add('hidden');
              return;
            }

            const terms = query.split(/\s+/).filter(Boolean);
            const matches = items.filter(item => {
              const text = item.keywords;
              return terms.every(t => text.includes(t));
            }).slice(0, 20);

            statusEl.classList.remove('hidden');
            if (matches.length === 0) {
              statusEl.textContent = `No districts found matching "${input.value}". Try searching by district name, headquarters, or province.`;
              resultsBox.classList.add('hidden');
              resultsBox.innerHTML = '';
              return;
            }

            statusEl.textContent = `Found ${matches.length} matching district${matches.length > 1 ? 's' : ''}:`;
            resultsBox.classList.remove('hidden');
            resultsBox.innerHTML = matches.map(m => `
              <div class="p-3 bg-white border border-slate-200 rounded-xl hover:border-indigo-300 transition shadow-2xs">
                <div class="flex items-center justify-between gap-2">
                  <div>
                    <div class="font-bold text-xs sm:text-sm text-slate-900">${m.name} District</div>
                    <div class="text-[11px] text-slate-600 mt-0.5">Headquarters: <strong class="text-slate-800">${m.hq}</strong> · <span class="text-indigo-700 font-medium">${m.province}</span></div>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="text-xs font-bold text-slate-900">${m.pop}</div>
                    <div class="text-[10px] text-slate-500">${m.area}</div>
                  </div>
                </div>
              </div>
            `).join('');
          }, 150);
        });
      }

      function setupSubMetroSearch() {
