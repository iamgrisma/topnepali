---
// Footer.astro — Unified 4-Column Footer for TopNepali matching the edge network ecosystem
const currentYear = new Date().getFullYear();

const networkLinks = [
  { name: 'TopNepali', url: 'https://topnepali.com' },
  { name: 'TopTools Utilities', url: 'https://topnepali.com/tools' },
  { name: 'Nepali Typing Platform', url: 'https://typing.topnepali.com' },
  { name: 'FontsDir Typography', url: 'https://fonts.topnepali.com' },
  { name: 'Flashare Transfer', url: 'https://share.topnepali.com' },
  { name: 'Election Archive', url: 'https://election.topnepali.com' },
  { name: 'Nepal Constitution', url: 'https://constitution.topnepali.com' }
];

const categoryLinks = [
  { name: 'Education & Routines', url: '/category/education' },
  { name: 'Loksewa Notices', url: '/category/loksewa' },
  { name: 'Exam Forms', url: '/category/exam-form' },
  { name: 'Bachelor Examination', url: '/category/bachelor-2nd-year' },
  { name: 'Finance & Banking', url: '/category/finance' },
  { name: 'Biographies', url: '/category/biography' }
];

const legalLinks = [
  { name: 'About Us', url: '/about-us' },
  { name: 'Contact & Feedback', url: '/contact' },
  { name: 'Privacy Policy', url: '/privacy' },
  { name: 'Terms of Service', url: '/terms-and-conditions' }
];
---

<footer class="site-footer">
  <div class="footer-container">
    <!-- 4-Column Responsive Grid -->
    <div class="footer-grid">
      <!-- Col 1: About Top Nepali -->
      <div class="footer-col">
        <div class="flex items-center gap-2.5 mb-3">
          <img
            src="https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png"
            alt="Top Nepali"
            class="w-7 h-7 rounded"
          />
          <span class="font-bold text-slate-900 text-sm tracking-tight">Top Nepali</span>
        </div>
        <p class="text-slate-600 text-xs leading-relaxed mb-4">
          Covering top Nepali news, verified exam routines, educational notices, and digital utility services built specifically for Nepal.
        </p>
        <span class="text-[11px] text-slate-500">
          Independent digital information archive.
        </span>
      </div>

      <!-- Col 2: Key Categories -->
      <div class="footer-col">
        <h4 class="col-title">Categories</h4>
        <ul class="col-list">
          {categoryLinks.map((cat) => (
            <li>
              <a href={cat.url} class="col-link">{cat.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Network Ecosystem -->
      <div class="footer-col">
        <h4 class="col-title">TopNepali Network</h4>
        <ul class="col-list">
          {networkLinks.map((item) => (
            <li>
              <a href={item.url} class="col-link">{item.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Platform & Legal -->
      <div class="footer-col">
        <h4 class="col-title">Information</h4>
        <ul class="col-list">
          {legalLinks.map((leg) => (
            <li>
              <a href={leg.url} class="col-link">{leg.name}</a>
            </li>
          ))}
        </ul>
        <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500">
          Questions or inquiries?
          <a href="mailto:contact@topnepali.com" class="text-blue-600 hover:underline block mt-0.5">
            contact@topnepali.com
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Strip -->
    <div class="footer-bottom">
      <div class="copyright-text">
        Copyright &copy; 2020 - {currentYear} <a href="/" class="text-slate-800 hover:underline font-semibold">Top Nepali</a> | All Rights Reserved!
      </div>
      <div class="flex items-center gap-3 text-xs">
        <a href="/privacy" class="hover:underline">Privacy</a>
        <span>&bull;</span>
        <a href="/terms-and-conditions" class="hover:underline">Terms</a>
        <span>&bull;</span>
        <a href="/contact" class="hover:underline">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #475569;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 16px 24px 16px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-bottom: 40px;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .col-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0f172a;
    margin-bottom: 14px;
  }

  .col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .col-link {
    font-size: 12.5px;
    color: #475569;
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .col-link:hover {
    color: #21138a;
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 20px;
    border-top: 1px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: #64748b;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }
</style>
