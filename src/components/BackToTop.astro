---
// BackToTop.astro — Modern floating Back to Top button with smooth scroll
---

<button
  type="button"
  id="back-to-top-btn"
  aria-label="Back to top"
  title="Back to top"
  class="fixed bottom-6 right-6 z-40 p-3 rounded-full bg-slate-900/85 hover:bg-indigo-600 text-white shadow-lg backdrop-blur-xs transition-all duration-300 ease-out transform translate-y-16 opacity-0 pointer-events-none cursor-pointer hover:shadow-indigo-500/25 hover:scale-105 active:scale-95"
>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="m18 15-6-6-6 6"></path>
  </svg>
</button>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    if (!btn) return;

    let isVisible = false;

    function handleScroll() {
      const shouldShow = window.scrollY > 350;
      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        if (isVisible) {
          btn.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
          btn.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          btn.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          btn.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
        }
      }
    }

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
