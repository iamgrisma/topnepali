---
// Header.astro — Faithful replica of TopNepali header layout with dropdowns, 9-dot launcher, and mobile drawer
import TopNepaliNetwork from './TopNepaliNetwork.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Home', url: '/' },
  {
    name: 'Updates',
    url: '/category/topnepali',
    children: [
      { name: 'TopNepali', url: '/category/topnepali' },
      { name: 'General Knowledge', url: '/category/general-knowledge' },
      { name: 'Biography', url: '/category/biography' }
    ]
  },
  {
    name: 'Education',
    url: '/category/education',
    children: [
      { name: 'Exam Form', url: '/category/exam-form' },
      { name: 'Exam Routines', url: '/category/exam-routines' },
      { name: 'Bachelor 1st Year', url: '/category/bachelor-first-year-exam-routine' },
      { name: 'Bachelor 2nd Year', url: '/category/bachelor-2nd-year' },
      { name: 'MBS and MPA', url: '/category/mbs-and-mpa' }
    ]
  },
  {
    name: 'Loksewa',
    url: '/category/loksewa',
    children: [
      { name: 'Exam Centers', url: '/category/exam-centers' },
      { name: 'Exam Date', url: '/category/exam-date' },
      { name: 'Finance & Banking', url: '/category/finance' }
    ]
  },
  {
    name: 'Tools',
    url: 'https://topnepali.com/tools',
    children: [
      { name: 'AD to BS Converter', url: 'https://topnepali.com/nepali-date-converter' },
      { name: 'Foreign Exchange Rates', url: 'https://topnepali.com/foreign-exchange-rates-for-nepali-currency' },
      { name: 'Nepali Calendar', url: 'https://topnepali.com/nepali-calendar' },
      { name: 'Nepali Rashifal', url: 'https://topnepali.com/nepali-rashifal-horoscope' },
      { name: 'Nepali Typing Platform', url: 'https://typing.topnepali.com' }
    ]
  },
  {
    name: 'More',
    url: '#',
    children: [
      { name: 'About Us', url: '/about-us' },
      { name: 'Contact', url: '/contact' },
      { name: 'Privacy Policy', url: '/privacy' },
      { name: 'Terms & Conditions', url: '/terms-and-conditions' }
    ]
  }
];
---

<header class="site-header">
  <div class="header-container">
    <!-- Branding / Logo -->
    <div class="site-branding">
      <a href="/" class="brand-link" rel="home">
        <img
          src="https://objects.topnepali.com/wp-content/uploads/2026/09/Top-Nepali-Logo.png"
          alt="Top Nepali"
          class="site-logo-img"
          width="48"
          height="48"
          loading="eager"
        />
        <div class="brand-text">
          <span class="site-title">Top Nepali</span>
          <span class="site-tagline">Covering Top Nepali News, Updates, Educational Information</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-menu">
        {navItems.map((item) => (
          <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
            <a
              href={item.url}
              class={`nav-link ${currentPath === item.url ? 'active' : ''}`}
            >
              <span>{item.name}</span>
              {item.children && (
                <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              )}
            </a>

            {item.children && (
              <ul class="dropdown-menu">
                {item.children.map((sub) => (
                  <li>
                    <a href={sub.url} class="dropdown-item">
                      {sub.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Search, 9-dot launcher, Mobile hamburger) -->
    <div class="header-actions">
      <!-- Search Trigger Button -->
      <button
        type="button"
        class="action-btn search-trigger"
        data-trigger="search-modal"
        aria-label="Open search dialog"
        title="Search"
      >
        <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>

      <!-- 9-Dot Ecosystem Launcher -->
      <TopNepaliNetwork currentApp="blog" />

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-drawer-toggle"
        class="action-btn mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="mobile-hamburger-icon" class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="mobile-close-icon" class="hamburger-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu (Inline below header, zero stuck blur backdrop) -->
  <div id="mobile-menu" class="mobile-dropdown-panel hidden" aria-label="Mobile Navigation">
    <!-- Quick Search in Mobile Menu -->
    <div class="mobile-search-section">
      <form action="/search" method="get" class="mobile-search-form">
        <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Search articles, routines, guides..."
          class="mobile-search-input"
          autocomplete="off"
        />
      </form>
    </div>

    <!-- Navigation Items -->
    <nav class="mobile-nav-body">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li class="mobile-nav-item">
            <a href={item.url} class={`mobile-nav-link ${currentPath === item.url ? 'active' : ''}`}>
              <span>{item.name}</span>
            </a>
            {item.children && (
              <ul class="mobile-subnav-list">
                {item.children.map((sub) => (
                  <li>
                    <a href={sub.url} class="mobile-subnav-link">
                      <span>{sub.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .site-branding {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .site-logo-img {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .site-title {
    font-size: 19px;
    font-weight: 800;
    color: #21138a;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .site-tagline {
    font-size: 10px;
    color: #64748b;
    font-weight: 500;
    line-height: 1.2;
    display: none;
  }

  @media (min-width: 1024px) {
    .site-tagline {
      display: block;
    }
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 880px) {
    .desktop-nav {
      display: flex;
      align-items: center;
    }
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .nav-link:hover,
  .nav-item:hover > .nav-link {
    color: #21138a;
    background: #f1f5f9;
  }

  .nav-link.active {
    color: #21138a;
    font-weight: 700;
  }

  .dropdown-caret {
    width: 13px;
    height: 13px;
    opacity: 0.6;
    transition: transform 0.15s ease;
  }

  .nav-item:hover .dropdown-caret {
    transform: rotate(180deg);
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    padding: 6px;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.15s ease;
    z-index: 1000;
  }

  .nav-item:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: block;
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 500;
    color: #334155;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.12s ease;
  }

  .dropdown-item:hover {
    background: #f8fafc;
    color: #21138a;
    padding-left: 15px;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: transparent;
    border: 1px solid transparent;
    color: #4b5563;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .action-icon,
  .hamburger-icon {
    width: 20px;
    height: 20px;
  }

  .mobile-menu-btn {
    display: flex;
  }

  @media (min-width: 880px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  /* Mobile Dropdown Panel */
  .mobile-dropdown-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #ffffff;
    border-bottom: 2px solid #21138a;
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.18);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    z-index: 1001;
  }

  .mobile-dropdown-panel.hidden {
    display: none;
  }

  .mobile-search-section {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    background: #f8fafc;
  }

  .mobile-search-form {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 7px 12px;
  }

  .mobile-search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 13px;
    color: #1e293b;
  }

  .mobile-nav-body {
    padding: 12px 16px 24px 16px;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-nav-item {
    border-bottom: 1px solid #f8fafc;
    padding-bottom: 4px;
  }

  .mobile-nav-link {
    display: block;
    padding: 8px 10px;
    font-size: 14.5px;
    font-weight: 700;
    color: #1e293b;
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.15s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #21138a;
    background: #f1f5f9;
  }

  .mobile-subnav-list {
    list-style: none;
    margin: 2px 0 6px 12px;
    padding-left: 10px;
    border-left: 2px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-subnav-link {
    display: block;
    padding: 5px 8px;
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.12s ease;
  }

  .mobile-subnav-link:hover {
    color: #21138a;
    background: #f8fafc;
    padding-left: 12px;
  }
</style>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-drawer-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('mobile-hamburger-icon');
    const close = document.getElementById('mobile-close-icon');

    if (!toggle || !menu) return;

    function openMenu() {
      menu?.classList.remove('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
      hamburger?.classList.add('hidden');
      close?.classList.remove('hidden');
    }

    function closeMenu() {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      hamburger?.classList.remove('hidden');
      close?.classList.add('hidden');
    }

    function toggleMenu(e?: Event) {
      if (e) e.stopPropagation();
      const isHidden = menu?.classList.contains('hidden');
      if (isHidden) {
        openMenu();
      } else {
        closeMenu();
      }
    }

    toggle.onclick = toggleMenu;

    // Close when clicking any link inside
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on outside tap/click
    document.addEventListener('click', (e) => {
      if (!menu.classList.contains('hidden')) {
        const target = e.target as HTMLElement;
        if (!menu.contains(target) && !toggle.contains(target)) {
          closeMenu();
        }
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
