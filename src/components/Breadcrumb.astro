---
// Breadcrumb.astro — Centralized, aesthetic breadcrumb component with chevron separators
export interface BreadcrumbCrumb {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbCrumb[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

{items.length > 0 && (
  <nav
    class={`flex items-center justify-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs text-slate-500 mb-6 flex-wrap text-center py-1.5 px-4 bg-slate-50/85 hover:bg-slate-50 border border-slate-200/75 rounded-full shadow-2xs max-w-fit mx-auto transition-colors ${className}`}
    aria-label="Breadcrumb"
  >
    {items.map((crumb, idx) => {
      const isFirst = idx === 0;
      const isLast = idx === items.length - 1;
      return (
        <span class="inline-flex items-center gap-1.5 sm:gap-2">
          {idx > 0 && (
            <svg
              class="w-3 h-3 text-slate-400 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          )}
          {crumb.href && !isLast ? (
            <a
              href={crumb.href}
              class="inline-flex items-center gap-1 text-slate-600 hover:text-indigo-600 font-medium transition-colors"
            >
              {isFirst && (
                <svg
                  class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-600 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              )}
              <span>{crumb.label}</span>
            </a>
          ) : (
            <span class="text-slate-800 font-semibold truncate max-w-[180px] sm:max-w-xs md:max-w-md">
              {crumb.label}
            </span>
          )}
        </span>
      );
    })}
  </nav>
)}
