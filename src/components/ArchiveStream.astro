---
import PostCard from './PostCard.astro';
import Sidebar from './Sidebar.astro';
import Pagination from './Pagination.astro';
import Breadcrumb from './Breadcrumb.astro';
import type { WPPost } from '../types/wp';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface TopicChip {
  name: string;
  href: string;
  count?: number;
  active?: boolean;
}

interface Props {
  badgeLabel?: string;
  heading: string;
  description?: string;
  total: number;
  breadcrumbs: BreadcrumbItem[];
  subCategories?: TopicChip[];
  topicChips?: TopicChip[];
  topicChipsLabel?: string;
  posts: WPPost[];
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  featuredPost?: WPPost | null;
  emptyMessage?: string;
}

const {
  badgeLabel = 'Editorial Feed',
  heading,
  description,
  total,
  breadcrumbs,
  subCategories = [],
  topicChips = [],
  topicChipsLabel = 'Topics:',
  posts,
  currentPage,
  totalPages,
  baseUrl,
  featuredPost = null,
  emptyMessage = 'No articles found in this feed.',
} = Astro.props;

const isFirstPage = currentPage === 1;
const streamPosts = (featuredPost && isFirstPage) ? posts.slice(1) : posts;
---

<div class="max-w-[1280px] mx-auto px-4 py-6 sm:py-10">
  <!-- Breadcrumbs -->
  <Breadcrumb items={breadcrumbs} />

  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <!-- Primary Content Stream -->
    <div class="w-full lg:w-[68%] min-w-0">
      <!-- Archive Header -->
      <header class="p-6 sm:p-8 mb-8 bg-white rounded-2xl border border-slate-200 shadow-2xs">
        <div class="flex items-center justify-between gap-4 mb-3">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
            <span>{badgeLabel}</span>
          </div>
          <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200/80">
            {total > 0 ? `${total} ${total === 1 ? 'Article' : 'Articles'}` : 'Live Feed'}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight mb-2">
          {heading}
        </h1>

        {description && (
          <p class="text-sm text-slate-600 leading-relaxed max-w-2xl">
            {description}
          </p>
        )}

        {subCategories.length > 0 && (
          <nav class="mt-4 pt-4 border-t border-slate-100 flex items-center gap-2 flex-wrap text-xs" aria-label="Subcategories">
            <span class="text-slate-500 font-semibold uppercase tracking-wider shrink-0 mr-1 text-[11px]">Subcategories:</span>
            {subCategories.map((sub) => (
              <a
                href={sub.href}
                class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 hover:bg-indigo-100 font-medium transition"
              >
                <span>{sub.name}</span>
                {typeof sub.count === 'number' && (
                  <span class="text-indigo-400 font-mono text-[11px]">({sub.count})</span>
                )}
              </a>
            ))}
          </nav>
        )}

        {topicChips.length > 0 && (
          <nav class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2 overflow-x-auto pb-1 text-xs" aria-label="Topic filter">
            <span class="text-slate-400 font-medium shrink-0 mr-1">{topicChipsLabel}</span>
            {topicChips.map((chip) => (
              <a
                href={chip.href}
                class={`shrink-0 px-3 py-1 rounded-full font-medium transition ${
                  chip.active
                    ? 'font-semibold bg-indigo-600 text-white shadow-2xs'
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {chip.name}
              </a>
            ))}
          </nav>
        )}
      </header>

      <!-- Lead Featured Post -->
      {featuredPost && isFirstPage && (
        <section class="mb-8" aria-label="Featured Story">
          <PostCard post={featuredPost} featured={true} />
        </section>
      )}

      <!-- Stream Divider -->
      <div class="flex items-center justify-between pb-3 mb-6 border-b-2 border-slate-200">
        <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
          <span>{isFirstPage ? 'Recent Publications' : `Articles: Page ${currentPage}`}</span>
        </h2>
        <span class="text-xs text-slate-500">
          Page {currentPage} of {totalPages || 1}
        </span>
      </div>

      <!-- Post Stream Grid -->
      {streamPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {streamPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="p-8 text-center bg-white rounded-2xl border border-slate-200">
          <p class="text-slate-600 text-sm">{emptyMessage}</p>
          <a href="/blogs" class="mt-3 inline-block text-xs font-semibold text-indigo-600 hover:underline">
            Browse All Articles
          </a>
        </div>
      )}

      <!-- Dynamic Pagination -->
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={baseUrl}
      />
    </div>

    <!-- Right Sidebar -->
    <div class="w-full lg:w-[32%] shrink-0">
      <Sidebar excludePostId={featuredPost?.id} recentPosts={posts} />
    </div>
  </div>
</div>
