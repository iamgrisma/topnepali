---
interface Action {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  message?: string;
  showSearch?: boolean;
  searchQuery?: string;
  icon?: 'file-question' | 'folder' | 'tag' | 'search';
  primaryAction?: Action;
  secondaryAction?: Action;
}

const {
  title = 'Page Not Found',
  message = 'The requested resource could not be found or may have been consolidated.',
  showSearch = true,
  searchQuery = '',
  icon = 'file-question',
  primaryAction = { label: 'Return to Portal', href: '/' },
  secondaryAction = { label: 'Browse All Blogs', href: '/blogs' },
} = Astro.props;
---

<div class="p-8 sm:p-12 text-center bg-white rounded-2xl border border-slate-200 shadow-2xs">
  <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
    {icon === 'file-question' && (
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
    )}
    {icon === 'folder' && (
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        <line x1="12" y1="11" x2="12" y2="17" />
        <line x1="9" y1="14" x2="15" y2="14" />
      </svg>
    )}
    {icon === 'tag' && (
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
        <line x1="7" y1="7" x2="7.01" y2="7" />
      </svg>
    )}
    {icon === 'search' && (
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    )}
  </div>

  <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">{title}</h1>
  <p class="text-slate-600 text-sm max-w-md mx-auto mb-6 leading-relaxed">{message}</p>

  {showSearch && (
    <form action="/search" method="get" class="max-w-md mx-auto mb-6">
      <div class="relative flex items-center">
        <input
          type="search"
          name="q"
          value={searchQuery}
          placeholder="Search articles on Top Nepali..."
          required
          class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-4 pr-10 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-hidden focus:border-indigo-600 transition"
        />
        <button
          type="submit"
          class="absolute right-2 p-1.5 text-slate-400 hover:text-indigo-600 transition"
          aria-label="Search"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
      </div>
    </form>
  )}

  <div class="flex items-center justify-center gap-3">
    {primaryAction && (
      <a href={primaryAction.href} class="px-5 py-2.5 bg-indigo-900 text-white rounded-lg text-xs font-semibold hover:bg-indigo-800 transition">
        {primaryAction.label}
      </a>
    )}
    {secondaryAction && (
      <a href={secondaryAction.href} class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-50 transition">
        {secondaryAction.label}
      </a>
    )}
  </div>
</div>
