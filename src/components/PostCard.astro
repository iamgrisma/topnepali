---
import type { WPPost } from '../types/wp';
import {
  formatDate,
  estimateReadingTime,
  getPostFeaturedImage,
  getPostAuthor,
  getPostCategories,
  getPostTitle,
  stripHtml
} from '../lib/wp';

interface Props {
  post: WPPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const title = getPostTitle(post);
const featuredImage = getPostFeaturedImage(post);
const author = getPostAuthor(post);
const categories = getPostCategories(post);
const primaryCategory = categories[0];
const readingTime = estimateReadingTime(post);
const excerpt = stripHtml(post.excerpt?.rendered || '');
---

<article class={`post-card ${featured ? 'is-featured' : ''}`}>
  {featuredImage && (
    <a href={`/${post.slug}`} class="card-media-link" tabindex="-1" aria-hidden="true">
      <img
        src={featuredImage.url}
        alt={featuredImage.alt}
        class="card-img"
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    </a>
  )}

  <div class="card-body">
    {primaryCategory && (
      <div class="card-category">
        <a href={`/category/${primaryCategory.slug}`} class="category-badge">
          {primaryCategory.name}
        </a>
      </div>
    )}

    <h2 class={`card-title ${featured ? 'text-xl sm:text-2xl' : 'text-base sm:text-lg'}`}>
      <a href={`/${post.slug}`} class="title-link">
        {title}
      </a>
    </h2>

    <div class="card-meta">
      <span class="meta-author">
        by <span class="font-medium text-slate-700">{author.name}</span>
      </span>
      <span class="meta-dot">&bull;</span>
      <time datetime={post.date} class="meta-date">
        {formatDate(post.date)}
      </time>
      <span class="meta-dot">&bull;</span>
      <span class="meta-read-time">{readingTime}</span>
    </div>

    {excerpt && (
      <p class="card-excerpt line-clamp-3">
        {excerpt}
      </p>
    )}

    <div class="card-footer">
      <a href={`/${post.slug}`} class="read-more-link">
        <span>Read Full Article</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .post-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.08);
    border-color: #cbd5e1;
  }

  .card-media-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f1f5f9;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .card-img {
    transform: scale(1.03);
  }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-category {
    margin-bottom: 10px;
  }

  .category-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #21138a;
    background: #eff6ff;
    padding: 2.5px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.12s ease;
  }

  .category-badge:hover {
    background: #dbeafe;
  }

  .card-title {
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 8px;
  }

  .title-link {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .title-link:hover {
    color: #21138a;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    margin-bottom: 12px;
  }

  .meta-dot {
    opacity: 0.6;
  }

  .card-excerpt {
    font-size: 13.5px;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 16px;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: #21138a;
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .read-more-link:hover {
    gap: 8px;
    text-decoration: underline;
  }
</style>
