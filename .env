# WordPress REST API source URL (works with any WordPress blog/site)
WORDPRESS_URL=https://topnepali.com

# Site branding & canonical URL
SITE_NAME="Top Nepali"
SITE_DESCRIPTION="Covering Top Nepali News, Updates, Educational Information"
SITE_URL=https://topnepali.com

# Pagination
POSTS_PER_PAGE=10

# On-Demand Cache Invalidation Webhook Secret
REVALIDATE_SECRET=topnepali_revalidate_secure_token

# Optional: Cloudflare Global CDN Edge Purge Credentials
# (If configured, /api/revalidate calls Cloudflare to purge edge cache within 200ms)
# CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_cache_purge_permission
