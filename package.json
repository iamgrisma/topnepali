{
  "name": "topnepali",
  "type": "module",
  "version": "1.0.0",
  "description": "Headless WordPress Platform for TopNepali on Astro SSR",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro-cli.js dev --host 0.0.0.0 --port 3000",
    "start": "node ./dist/server/entry.mjs",
    "build": "node scripts/astro-cli.js build --cloudflare",
    "build:cf": "node scripts/astro-cli.js build --cloudflare",
    "build:node": "node scripts/astro-cli.js build --node",
    "deploy": "npm run build && wrangler deploy",
    "preview": "node scripts/astro-cli.js preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/node": "^11.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.20.3",
    "wrangler": "^4.131.0"
  }
}
